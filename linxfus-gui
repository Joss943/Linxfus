def find_backend():
    for p in (os.path.join(HERE, 'linxfus'), '/usr/local/bin/linxfus', '/usr/bin/linxfus'):
        if os.path.isfile(p) and os.access(p, os.X_OK):
            return p
    return None


def human(n):
    g = n / 1e9
    return f'{g:.0f} Go' if g >= 10 else f'{g:.1f} Go' if g >= 1 else f'{n / 1e6:.0f} Mo'


def fat_label(s, default=''):
    s = re.sub(r'[^A-Z0-9_-]', '', s.upper())[:11]
    return s or default


def detect(path):
    """Type d'image sans droits root : extension, puis signature (blkid)."""
    low = path.lower()
    if low.endswith('.dmg'):
        return 'mac', 'MACRECOVERY'
    if low.endswith(('.xz', '.gz', '.zst', '.bz2', '.img', '.raw', '.bin')):
        return 'linux', ''
    info = {}
    blkid = shutil.which('blkid', path=SYS_PATH)
    if blkid:
        try:
            out = subprocess.run([blkid, '-p', '-o', 'export', path], capture_output=True,
                                 text=True, timeout=20).stdout
            for line in out.splitlines():
                k, _, v = line.partition('=')
                info[k] = v.replace('\\ ', ' ')
        except (OSError, subprocess.SubprocessError):
            pass
    label, fs = info.get('LABEL', ''), info.get('TYPE', '')
    if fs == 'udf' or label.upper().startswith('CCCOMA_'):   # ISO Microsoft = UDF
        return 'windows', label
    if fs.startswith('hfs'):
        return 'mac', label
    return 'linux', label


def dropdown(items, sensitive=True):
    d = Gtk.DropDown.new_from_strings(items)
    d.set_hexpand(True)
    d.set_sensitive(sensitive)
    return d


def set_items(dd, items, selected=0):
    dd.set_model(Gtk.StringList.new(items))
    dd.set_selected(min(selected, len(items) - 1))


def field(title, widget):
    box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4, hexpand=True)
    box.append(Gtk.Label(label=title, xalign=0))
    box.append(widget)
    return box


def section(title):
    box = Gtk.Box(spacing=10, margin_top=6)
    lab = Gtk.Label(label=title, xalign=0)
    lab.add_css_class('section')
    box.append(lab)
    box.append(Gtk.Separator(hexpand=True, valign=Gtk.Align.CENTER))
    return box


