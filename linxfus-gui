    # ───────── utilitaires ─────────
    def log(self, text):
        self.log_buf.insert(self.log_buf.get_end_iter(), text + '\n')

    def alert(self, msg, detail='', buttons=None, cb=None):
        d = Gtk.AlertDialog(message=msg, detail=detail, modal=True)
        if buttons:
            d.set_buttons(buttons)
            d.set_cancel_button(0)
            d.set_default_button(0)

        def done(dlg, res):
            try:
                idx = dlg.choose_finish(res)
            except GLib.Error:
                idx = -1
            if cb:
                cb(idx)
        d.choose(self, None, done)

    def sel_dev(self):
        i = self.dev_dd.get_selected()
        return self.devices[i] if self.devices and i < len(self.devices) else None

    def copy(self, text):
        self.get_clipboard().set_content(Gdk.ContentProvider.new_for_value(text))

    def set_bar(self, frac=None, text=None):
        if frac is not None:
            self.bar.set_fraction(max(0.0, min(1.0, frac)))
        if text is not None:
            self.bar_lab.set_label(text)

    # ───────── périphériques ─────────
    def refresh_devices(self, force=False):
        if self.busy:
            return True
        try:
            sig = tuple((b, open(f'/sys/block/{b}/size').read()) for b in sorted(os.listdir('/sys/block')))
        except OSError:
            sig = None
        if not force and sig == self.dev_sig:
            return True
        self.dev_sig = sig
        old = (self.sel_dev() or (None,))[0]
        devs = []
        if self.backend:
            cmd = [self.backend, '-l', '--gui'] + (['-f'] if self.all_chk.get_active() else [])
            try:
                out = subprocess.run(cmd, capture_output=True, text=True, timeout=15,
                                     env={'PATH': SYS_PATH, 'LANG': 'C.UTF-8'}).stdout
                for line in out.splitlines():
                    p = line.split('|')
                    if len(p) == 3 and p[0].startswith('/dev/') and p[1].isdigit():
                        devs.append((p[0], int(p[1]), p[2]))
            except (OSError, subprocess.SubprocessError):
                pass
        self.devices = devs
        self.updating = True
        if devs:
            names = [f'{m} ({d}) [{human(s)}]' for d, s, m in devs]
            paths = [d for d, _, _ in devs]
            set_items(self.dev_dd, names, paths.index(old) if old in paths else 0)
        else:
            set_items(self.dev_dd, ['Aucun périphérique détecté'])
        self.updating = False
        n = len(devs)
        self.status.set_label(f'{n} périphérique{"s" if n > 1 else ""} trouvé{"s" if n > 1 else ""}')
        self.update_ui()
        return True

    # ───────── image ─────────
    def set_image(self, path):
        if self.busy or not path:
            return
        if not os.path.isfile(path):
            self.alert('Fichier illisible', 'Choisis une image locale (ISO, IMG, DMG…).')
            return
        self.image = path
        self.img_kind, self.img_label = detect(path)
        self.efi, self.mode = None, None
        self.updating = True
        set_items(self.boot_dd, [os.path.basename(path)] + BOOT_EXTRA, 0)
        self.updating = False
        self.set_bar(0, 'PRÊT')
        kinds = {'windows': 'Windows', 'mac': 'macOS', 'linux': 'Linux / image brute'}
        self.conf['last_dir'] = os.path.dirname(path)
        save_conf(self.conf)
        self.log(f'Image : {path} — {kinds[self.img_kind]}')
        self.status.set_label(f'Image {kinds[self.img_kind]} sélectionnée')
        self.update_ui()

    def on_select(self, _btn):
        f = Gtk.FileFilter(name='Images disque (ISO, IMG, DMG, XZ…)')
        for s in IMG_SUFFIXES:
            f.add_suffix(s)
        a = Gtk.FileFilter(name='Tous les fichiers')
        a.add_pattern('*')
        filters = Gio.ListStore.new(Gtk.FileFilter)
        filters.append(f)
        filters.append(a)
        d = Gtk.FileDialog(title='Choisir une image', modal=True, filters=filters, default_filter=f)
        if os.path.isdir(self.conf.get('last_dir', '')):
            d.set_initial_folder(Gio.File.new_for_path(self.conf['last_dir']))

        def done(dlg, res):
            try:
                self.set_image(dlg.open_finish(res).get_path())
            except GLib.Error:
                pass
        d.open(self, None, done)

    def on_efi(self, _btn):
        def done(dlg, res):
            try:
                self.efi = dlg.select_folder_finish(res).get_path()
                self.efi_lab.set_label(self.efi)
            except GLib.Error:
                pass
        Gtk.FileDialog(title='Dossier EFI OpenCore', modal=True).select_folder(self, None, done)

    def on_hash(self, _btn):
        if not self.image or self.busy:
            return
        self.busy = True
        self.update_ui()
        path, size = self.image, os.path.getsize(self.image) or 1

        def work():
            h, done = hashlib.sha256(), 0
            with open(path, 'rb') as fh:
                while chunk := fh.read(4 << 20):
                    h.update(chunk)
                    done += len(chunk)
                    GLib.idle_add(self.set_bar, done / size, f'Calcul du SHA-256 : {100 * done / size:.0f} %')
            GLib.idle_add(self.hash_done, h.hexdigest())
        threading.Thread(target=work, daemon=True).start()

    def hash_done(self, digest):
        self.busy = False
        self.set_bar(0, 'PRÊT')
        self.update_ui()
        self.log(f'SHA-256 {os.path.basename(self.image)} : {digest}')

        def copy(idx):
            if idx == 1:
                self.copy(digest)
        self.alert('SHA-256', f'{os.path.basename(self.image)}\n\n{digest}', ['OK', 'Copier'], copy)

    # ───────── options (comme Rufus : seules les options utiles sont actives) ─────────
    def on_mode(self, *_):
        if not (self.updating or self.busy):   # nouveau mode : on repart d'une barre vide
            self.set_bar(0, 'PRÊT')
        self.update_ui()

    def kind(self):
        return {1: 'mac-dl', 2: 'format'}.get(self.boot_dd.get_selected(), self.img_kind)

    def update_ui(self):
        if self.updating:
            return
        self.updating = True
        k, idle = self.kind(), not self.busy
        mac, fmt = k in ('mac', 'mac-dl'), k == 'format'
        first = lambda dd: dd.get_model().get_string(0)   # noqa: E731
        self.opt_field.set_visible(k in ('windows', 'mac-dl'))
        if k == 'windows' and first(self.opt_dd) != 'Installation standard de Windows':
            set_items(self.opt_dd, ['Installation standard de Windows'])
        if k == 'mac-dl' and first(self.opt_dd) != MACOS[0][1]:
            set_items(self.opt_dd, [n for _, n in MACOS])
        if k == 'windows' or fmt:
            if first(self.scheme_dd) != 'MBR':
                set_items(self.scheme_dd, ['MBR', 'GPT'])
            gpt = self.scheme_dd.get_selected() == 1
            set_items(self.target_dd, ['Stockage (non amorçable)'] if fmt else
                      ['UEFI (non CSM)' if gpt else 'BIOS ou UEFI'])
        elif mac:
            set_items(self.scheme_dd, ['GPT'])
            if first(self.target_dd) != 'Mac Intel (image disque)':
                set_items(self.target_dd, ['Mac Intel (image disque)', 'Hackintosh (OpenCore)'])
        else:
            set_items(self.scheme_dd, ['Défini par l\'image'])
            set_items(self.target_dd, ['Défini par l\'image'])
        hack = mac and self.target_dd.get_selected() == 1
        fat = k == 'windows' or hack
        if fmt:
            names = [f[1] for f in self.fs_avail]
            if [self.fs_dd.get_model().get_string(i) for i in range(self.fs_dd.get_model().get_n_items())] != names:
                set_items(self.fs_dd, names)
            self.label_ent.set_max_length(self.fs_avail[self.fs_dd.get_selected()][3])
        else:
            set_items(self.fs_dd, ['FAT32' if fat else 'Défini par l\'image'])
            self.label_ent.set_max_length(11)
        if (k, hack) != self.mode:   # nom de volume par défaut, comme Rufus
            self.mode = (k, hack)
            self.label_ent.set_text('MACRECOVERY' if hack else fat_label(self.img_label, 'WINUSB')
                                    if k == 'windows' else self.img_label if k in ('linux', 'mac') else '')
        self.efi_field.set_visible(hack)
        newer = k == 'mac-dl' and not hack and self.opt_dd.get_selected() < 6
        self.hint.set_label('Mac Intel : fiable jusqu\'à Catalina. Si cette version est refusée, '
                            'choisis « Hackintosh (OpenCore) » : la clé n\'est pas effacée avant.' if newer else '')
        self.hint.set_visible(newer)
        self.updating = False

        img = k in ('windows', 'linux', 'mac')
        self.dev_dd.set_sensitive(idle and bool(self.devices))
        self.boot_dd.set_sensitive(idle)
        self.sel_btn.set_sensitive(idle and (img or k is None))
        self.hash_btn.set_sensitive(idle and bool(self.image) and img)
        self.opt_dd.set_sensitive(idle and k == 'mac-dl')
        self.scheme_dd.set_sensitive(idle and (k == 'windows' or fmt))
        self.target_dd.set_sensitive(idle and mac)
        self.fs_dd.set_sensitive(idle and fmt and len(self.fs_avail) > 1)
        self.label_ent.set_sensitive(idle and (fat or fmt))
        self.verify_chk.set_sensitive(idle and k == 'linux')
        self.sha_ent.set_sensitive(idle and img)
        self.all_chk.set_sensitive(idle)
        self.start_btn.set_sensitive(idle and bool(self.sel_dev()) and bool(self.backend) and k is not None)
        self.close_btn.set_label('ANNULER' if self.proc else 'FERMER')

    # ───────── écriture ─────────
    def build_args(self):
        k, dev = self.kind(), self.sel_dev()[0]
        gpt = self.scheme_dd.get_selected() == 1
        args = ['-d', dev]
        if k == 'format':
            args += ['--format', self.fs_avail[self.fs_dd.get_selected()][0], '-s', 'gpt' if gpt else 'mbr']
        elif k == 'mac-dl':
            args += ['--mac-recovery', MACOS[self.opt_dd.get_selected()][0]]
        else:
            args += ['-i', self.image]
        if k == 'windows':
            w = self.wue
            args += ['-s', 'gpt' if gpt else 'mbr']
            args += [flag for key, flag in (('bypass', '--win11-bypass'), ('no_online', '--no-online-account'),
                                            ('no_data', '--no-data-collection'), ('no_bitlocker', '--no-bitlocker'))
                     if w.get(key)]
            if w.get('user_on') and w.get('user'):
                args += ['--local-account', w['user']]
        if k in ('mac', 'mac-dl'):
            hack = self.target_dd.get_selected() == 1
            args += ['--mac-mode', 'opencore' if hack else 'raw']
            if hack and self.efi:
                args += ['--efi', self.efi]
        if self.label_ent.get_sensitive() and self.label_ent.get_text().strip():
            args += ['-L', self.label_ent.get_text().strip()]
        if self.verify_chk.get_sensitive() and self.verify_chk.get_active():
            args.append('-V')
        if self.sha_ent.get_sensitive() and self.sha_ent.get_text().strip():
            args += ['--sha256', self.sha_ent.get_text().strip().lower()]
        if self.all_chk.get_active():
            args.append('-f')
        return args

    def on_start(self, _btn):
        dev, k = self.sel_dev(), self.kind()
        if not dev:
            return
        sha = self.sha_ent.get_text().strip()
        if sha and self.sha_ent.get_sensitive() and not re.fullmatch(r'[0-9a-fA-F]{64}', sha):
            self.alert('SHA-256 invalide', 'Il faut 64 caractères hexadécimaux (0-9, a-f).')
            return
        if k in ('windows', 'linux') and not self.image.lower().endswith(('.xz', '.gz', '.zst', '.bz2')):
            size = os.path.getsize(self.image)
            if size > dev[1]:   # inutile de demander le mot de passe pour échouer ensuite
                self.alert('Clé trop petite', f'L\'image fait {human(size)} et la clé {human(dev[1])}.')
                return
        if k == 'windows':
            self.ask_wue(self.confirm)
        else:
            self.confirm()

    def confirm(self):
        d, _size, model = self.sel_dev()
        self.alert(f'AVERTISSEMENT : TOUTES LES DONNÉES DU PÉRIPHÉRIQUE « {model} ({d}) » VONT ÊTRE DÉTRUITES.',
                   'Pour continuer, cliquez sur OK. Pour quitter, cliquez sur Annuler.',
                   ['Annuler', 'OK'], lambda i: i == 1 and self.run(self.build_args()))

    def ask_wue(self, then):
        """Dialogue « Expérience utilisateur Windows », comme Rufus après DÉMARRER."""
        w = self.wue
        win = Gtk.Window(title='Expérience utilisateur Windows', transient_for=self, modal=True, resizable=False)
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8, margin_top=16, margin_bottom=14,
                      margin_start=18, margin_end=18)
        head = Gtk.Label(label='Personnaliser l\'installation de Windows ?', xalign=0, margin_bottom=4)
        head.add_css_class('section')
        box.append(head)
        chk = {key: Gtk.CheckButton(label=text, active=bool(w.get(key))) for key, text in (
            ('bypass', 'Supprimer la nécessité d\'avoir 4 Go+ de RAM, Secure Boot et TPM 2.0'),
            ('no_online', 'Supprimer la nécessité d\'utiliser un compte Microsoft en ligne'),
            ('user_on', 'Créer un compte local sous le nom de :'),
            ('no_data', 'Désactiver la collecte de données (supprime les questions de confidentialité)'),
            ('no_bitlocker', 'Désactiver le chiffrement automatique BitLocker'))}
        ent = Gtk.Entry(text=w.get('user') or GLib.get_user_name(), max_length=20, hexpand=True)
        for key, c in chk.items():
            if key == 'user_on':
                row = Gtk.Box(spacing=8)
                row.append(c)
                row.append(ent)
                box.append(row)
            else:
                box.append(c)
        tip = ('Le compte local est créé sans mot de passe : Windows demande d\'en choisir un '
               'à la première ouverture de session.')
        note = Gtk.Label(xalign=0, wrap=True, max_width_chars=64, margin_top=4, label=tip)
        note.add_css_class('status')
        box.append(note)
        ok, cancel = Gtk.Button(label='OK', width_request=96), Gtk.Button(label='Annuler', width_request=96)
        row = Gtk.Box(spacing=6, halign=Gtk.Align.END, margin_top=8)
        row.append(ok)
        row.append(cancel)
        box.append(row)
        win.set_child(box)
        win.set_default_widget(ok)

        def accept(*_):
            name = ent.get_text().strip()
            if chk['user_on'].get_active() and not valid_user(name):
                ent.add_css_class('error')
                note.set_label('Nom de compte invalide : 20 caractères max (lettres, chiffres, espace, point, '
                               'tiret), et pas un nom réservé comme « Administrateur ».')
                return
            self.wue = {key: c.get_active() for key, c in chk.items()} | {'user': name}
            self.conf['wue'] = self.wue
            save_conf(self.conf)
            win.close()
            then()
        ok.connect('clicked', accept)
        ent.connect('activate', accept)
        ent.connect('changed', lambda *_: (ent.remove_css_class('error'), note.set_label(tip)))
        chk['user_on'].connect('toggled', lambda c: ent.set_sensitive(c.get_active()))
        ent.set_sensitive(chk['user_on'].get_active())
        cancel.connect('clicked', lambda *_: win.close())
        win.ok_btn, win.user_ent, win.checks = ok, ent, chk
        self.wue_win = win
        win.present()

    def run(self, args):
        cmd = [self.backend, '--gui'] + args
        if os.geteuid() != 0:
            pk = shutil.which('pkexec', path=SYS_PATH)
            if not pk:
                self.alert('pkexec introuvable', 'Installe polkit (pkexec) pour obtenir les droits administrateur.')
                return
            cmd = [pk] + cmd
        self.log('$ ' + ' '.join(cmd))
        try:
            self.proc = subprocess.Popen(cmd, stdin=subprocess.PIPE, stdout=subprocess.PIPE,
                                         stderr=subprocess.STDOUT, start_new_session=True,
                                         env={'PATH': SYS_PATH, 'LANG': 'C.UTF-8'})
        except OSError as e:
            self.alert('Impossible de lancer le moteur', str(e))
            return
        self.busy, self.cancelled, self.error, self.warnings = True, False, '', []
        self.phase, self.frac, self.total, self.t0 = 'Autorisation administrateur', None, None, time.monotonic()
        self.set_bar(0, 'Autorisation administrateur…')
        self.update_ui()
        threading.Thread(target=self.reader, daemon=True).start()

    def reader(self):
        fd, buf = self.proc.stdout.fileno(), b''
        while chunk := os.read(fd, 65536):
            buf += chunk
            *parts, buf = re.split(rb'[\r\n]', buf)
            for p in parts:
                if p.strip():
                    GLib.idle_add(self.on_output, p.decode('utf-8', 'replace').strip())
        if buf.strip():
            GLib.idle_add(self.on_output, buf.decode('utf-8', 'replace').strip())
        GLib.idle_add(self.on_done, self.proc.wait())

    def on_output(self, s):
        if len(s) > 2 and s[0] == '@' and s[2] == ' ':
            tag, msg = s[1], s[3:]
            if tag == 'I':
                self.phase, self.frac, self.total, self.fmax = msg.rstrip('…. '), None, None, 0
                self.set_bar(0, self.phase)
                self.log(msg)
            elif tag == 'O':
                self.log('✓ ' + msg)
            elif tag == 'W':
                self.warnings.append(msg)
                self.log('⚠ ' + msg)
            elif tag == 'E':
                self.error = msg
                self.log('✗ ' + msg)
            elif tag == 'T' and msg.isdigit():
                self.total = int(msg) or None
            elif tag == 'F' and msg.isdigit():
                left = int(msg)
                self.fmax = max(self.fmax, left)
                self.progress(1 - left / self.fmax if self.fmax else 1)
            return False
        m = RE_DD.match(s)
        if m:
            done = int(m[1])
            if self.total:
                self.progress(done / self.total, done)
            else:   # taille finale inconnue (.gz, .bz2) : on affiche ce qui est écrit
                self.set_bar(None, f'{self.phase} : {human(done)}')
            return False
        m = RE_PCT.search(s)
        if m and not s.startswith('Calcul'):
            self.progress(float(m[1].replace(',', '.')) / 100)
            return False
        self.log(s)
        return False

    def progress(self, frac, done=None):
        now = time.monotonic()
        frac = max(0.0, min(1.0, frac))
        if self.frac is None:
            self.pt0, self.f0 = now, frac
        self.frac = frac
        self.set_bar(frac, f'{self.phase} : {100 * frac:.1f} %')
        el = now - self.pt0
        if el >= 3 and frac > self.f0:   # vitesse et temps restant de l'étape en cours
            left = int(el * (1 - frac) / (frac - self.f0))
            txt = f'Temps restant : {left // 60:02d}:{left % 60:02d}'
            self.status.set_label(f'{done / el / 1e6:.1f} Mo/s — {txt}' if done else txt)

    def notify(self, body):
        app = self.get_application()
        if self.is_active() or app.get_dbus_connection() is None:
            return
        n = Gio.Notification.new('LinXfus')
        n.set_body(body)
        app.send_notification('fin', n)

    def tick(self):
        if self.proc:
            if self.frac is None:
                self.bar.pulse()
            s = int(time.monotonic() - self.t0)
            self.clock.set_label(f'{s // 3600:02d}:{s // 60 % 60:02d}:{s % 60:02d}')
        return True

    def on_done(self, rc):
        self.proc, self.busy = None, False
        if self.cancelled:
            self.set_bar(0, 'ANNULÉ')
            self.status.set_label('Opération annulée')
        elif rc == 0:
            self.set_bar(1, 'PRÊT')
            self.status.set_label(f'Terminé en {self.clock.get_label()}')
            self.notify('La clé est prête, tu peux la retirer.')
            if self.warnings:
                self.alert('Clé prête, avec des remarques', '\n\n'.join(self.warnings))
        elif rc in (126, 127) and not self.error:
            self.set_bar(0, 'PRÊT')
            self.status.set_label('Autorisation refusée ou annulée')
        else:
            self.set_bar(0, 'ERREUR')
            self.status.set_label('Échec — voir le journal')
            self.notify('Échec : ' + (self.error or 'voir le journal.'))
            self.alert('Erreur', self.error or f'Le moteur s\'est arrêté (code {rc}). Voir le journal.')
        self.log(f'— fin (code {rc})')
        self.refresh_devices(force=True)
        self.update_ui()
        return False

    # ───────── fermeture / annulation ─────────
    def cancel(self, idx):
        if idx == 1 and self.proc:
            self.cancelled = True
            self.set_bar(None, 'Annulation…')
            try:
                self.proc.stdin.close()   # le moteur détecte la fermeture et arrête tout proprement
            except OSError:
                pass

    def ask_cancel(self):
        self.alert('Annuler l\'opération en cours ?',
                   'La clé sera inutilisable tant qu\'elle n\'aura pas été réécrite.', ['Continuer', 'Annuler'],
                   self.cancel)

    def on_close(self, _btn):
        if self.proc:
            self.ask_cancel()
        else:
            self.close()

    def on_close_request(self, _win):
        if self.proc:
            self.ask_cancel()
            return True
        return False

    # ───────── à propos / journal ─────────
    def on_about(self, _btn):
        Gtk.AboutDialog(transient_for=self, modal=True, program_name='LinXfus', version=VERSION,
                        logo_icon_name=APP_ID, website='https://github.com/Joss943/Linxfus',
                        comments='Clés USB bootables Windows, macOS et Linux, comme Rufus.',
                        license_type=Gtk.License.MIT_X11, authors=['Josselin Lerendu']).present()

    def on_log(self, _btn):
        if self.log_win:
            self.log_win.present()
            return
        tv = Gtk.TextView(buffer=self.log_buf, editable=False, monospace=True, wrap_mode=Gtk.WrapMode.WORD_CHAR,
                          top_margin=8, bottom_margin=8, left_margin=8, right_margin=8)
        sw = Gtk.ScrolledWindow(child=tv, vexpand=True)
        copy = Gtk.Button(label='Copier le journal')
        copy.connect('clicked', lambda *_: self.copy(
            self.log_buf.get_text(self.log_buf.get_start_iter(), self.log_buf.get_end_iter(), False)))
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6, margin_bottom=8, margin_end=8)
        box.append(sw)
        copy.set_halign(Gtk.Align.END)
        box.append(copy)
        self.log_win = Gtk.Window(title='Journal LinXfus', transient_for=self, default_width=640,
                                  default_height=420, child=box, hide_on_close=True)
        self.log_win.present()


class App(Gtk.Application):
    def __init__(self):
        super().__init__(application_id=APP_ID, flags=Gio.ApplicationFlags.HANDLES_OPEN)
        self.win = None

    def do_startup(self):
        Gtk.Application.do_startup(self)
        css = Gtk.CssProvider()
        if hasattr(css, 'load_from_string'):
            css.load_from_string(CSS.decode())
        else:
            css.load_from_data(CSS, -1)
        Gtk.StyleContext.add_provider_for_display(Gdk.Display.get_default(), css,
                                                  Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
        Gtk.Window.set_default_icon_name(APP_ID)

    def do_activate(self):
        if not self.win:
            self.win = Window(self)
        self.win.present()

    def do_open(self, files, _n, _hint):
        self.do_activate()
        if files and files[0].get_path():
            self.win.set_image(files[0].get_path())


if __name__ == '__main__':
    sys.exit(App().run(sys.argv))
