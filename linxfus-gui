    # ───────── utilitaires ─────────
    def log(self, text):
        self.log_buf.insert(self.log_buf.get_end_iter(), text + '\n')

    def alert(self, msg, detail='', buttons=None, cb=None):
        d = Gtk.AlertDialog(message=msg, detail=detail, modal=True)
        if buttons:
            d.set_buttons(buttons)
            d.set_cancel_button(0)
            d.set_default_button(0)

        def done(dlg, res):
            try:
                idx = dlg.choose_finish(res)
            except GLib.Error:
                idx = -1
            if cb:
                cb(idx)
        d.choose(self, None, done)

    def sel_dev(self):
        i = self.dev_dd.get_selected()
        return self.devices[i] if self.devices and i < len(self.devices) else None

    def copy(self, text):
        self.get_clipboard().set_content(Gdk.ContentProvider.new_for_value(text))

    def set_bar(self, frac=None, text=None):
        if frac is not None:
            self.bar.set_fraction(max(0.0, min(1.0, frac)))
        if text is not None:
            self.bar_lab.set_label(text)

    # ───────── périphériques ─────────
    def refresh_devices(self, force=False):
        if self.busy:
            return True
        try:
            sig = tuple((b, open(f'/sys/block/{b}/size').read()) for b in sorted(os.listdir('/sys/block')))
        except OSError:
            sig = None
        if not force and sig == self.dev_sig:
            return True
        self.dev_sig = sig
        old = (self.sel_dev() or (None,))[0]
        devs = []
        if self.backend:
            cmd = [self.backend, '-l', '--gui'] + (['-f'] if self.all_chk.get_active() else [])
            try:
                out = subprocess.run(cmd, capture_output=True, text=True, timeout=15,
                                     env={'PATH': SYS_PATH, 'LANG': 'C.UTF-8'}).stdout
                for line in out.splitlines():
                    p = line.split('|')
                    if len(p) == 3 and p[0].startswith('/dev/') and p[1].isdigit():
                        devs.append((p[0], int(p[1]), p[2]))
            except (OSError, subprocess.SubprocessError):
                pass
        self.devices = devs
        self.updating = True
        if devs:
            names = [f'{m} ({d}) [{human(s)}]' for d, s, m in devs]
            paths = [d for d, _, _ in devs]
            set_items(self.dev_dd, names, paths.index(old) if old in paths else 0)
        else:
            set_items(self.dev_dd, ['Aucun périphérique détecté'])
        self.updating = False
        n = len(devs)
        self.status.set_label(f'{n} périphérique{"s" if n > 1 else ""} trouvé{"s" if n > 1 else ""}')
        self.update_ui()
        return True

    # ───────── image ─────────
    def set_image(self, path):
        if self.busy or not path:
            return
        if not os.path.isfile(path):
            self.alert('Fichier illisible', 'Choisis une image locale (ISO, IMG, DMG…).')
            return
        self.image = path
        self.img_kind, self.img_label = detect(path)
        self.efi, self.mode = None, None
        self.updating = True
        set_items(self.boot_dd, [os.path.basename(path), 'Télécharger macOS (serveurs Apple)'], 0)
        self.updating = False
        self.set_bar(0, 'PRÊT')
        kinds = {'windows': 'Windows', 'mac': 'macOS', 'linux': 'Linux / image brute'}
        self.log(f'Image : {path} — {kinds[self.img_kind]}')
        self.status.set_label(f'Image {kinds[self.img_kind]} sélectionnée')
        self.update_ui()

    def on_select(self, _btn):
        f = Gtk.FileFilter(name='Images disque (ISO, IMG, DMG, XZ…)')
        for s in IMG_SUFFIXES:
            f.add_suffix(s)
        a = Gtk.FileFilter(name='Tous les fichiers')
        a.add_pattern('*')
        filters = Gio.ListStore.new(Gtk.FileFilter)
        filters.append(f)
        filters.append(a)
        d = Gtk.FileDialog(title='Choisir une image', modal=True, filters=filters, default_filter=f)

        def done(dlg, res):
            try:
                self.set_image(dlg.open_finish(res).get_path())
            except GLib.Error:
                pass
        d.open(self, None, done)

    def on_efi(self, _btn):
        def done(dlg, res):
            try:
                self.efi = dlg.select_folder_finish(res).get_path()
                self.efi_lab.set_label(self.efi)
            except GLib.Error:
                pass
        Gtk.FileDialog(title='Dossier EFI OpenCore', modal=True).select_folder(self, None, done)

    def on_hash(self, _btn):
        if not self.image or self.busy:
            return
        self.busy = True
        self.update_ui()
        path, size = self.image, os.path.getsize(self.image) or 1

        def work():
            h, done = hashlib.sha256(), 0
            with open(path, 'rb') as fh:
                while chunk := fh.read(4 << 20):
                    h.update(chunk)
                    done += len(chunk)
                    GLib.idle_add(self.set_bar, done / size, f'Calcul du SHA-256 : {100 * done / size:.0f} %')
            GLib.idle_add(self.hash_done, h.hexdigest())
        threading.Thread(target=work, daemon=True).start()

    def hash_done(self, digest):
        self.busy = False
        self.set_bar(0, 'PRÊT')
        self.update_ui()
        self.log(f'SHA-256 {os.path.basename(self.image)} : {digest}')

        def copy(idx):
            if idx == 1:
                self.copy(digest)
        self.alert('SHA-256', f'{os.path.basename(self.image)}\n\n{digest}', ['OK', 'Copier'], copy)

    # ───────── options (comme Rufus : seules les options utiles sont actives) ─────────
    def kind(self):
        return 'mac-dl' if self.boot_dd.get_selected() == 1 else self.img_kind

    def update_ui(self):
        if self.updating:
            return
        self.updating = True
        k, idle = self.kind(), not self.busy
        mac = k in ('mac', 'mac-dl')
        self.opt_field.set_visible(k in ('windows', 'mac-dl'))
        if k == 'windows' and self.opt_dd.get_model().get_n_items() != 2:
            set_items(self.opt_dd, ['Installation standard de Windows',
                                    'Installation étendue (sans TPM / Secure Boot / 4 Go de RAM)'])
        if k == 'mac-dl' and self.opt_dd.get_model().get_n_items() != len(MACOS):
            set_items(self.opt_dd, [n for _, n in MACOS])
        if k == 'windows':
            if self.scheme_dd.get_model().get_n_items() != 2:
                set_items(self.scheme_dd, ['MBR', 'GPT'])
            set_items(self.target_dd, ['UEFI (non CSM)' if self.scheme_dd.get_selected() == 1 else 'BIOS ou UEFI'])
        elif mac:
            set_items(self.scheme_dd, ['GPT'])
            if self.target_dd.get_model().get_n_items() != 2:
                set_items(self.target_dd, ['Mac Intel (image disque)', 'Hackintosh (OpenCore)'])
        else:
            set_items(self.scheme_dd, ['Défini par l\'image'])
            set_items(self.target_dd, ['Défini par l\'image'])
        hack = mac and self.target_dd.get_selected() == 1
        fat = k == 'windows' or hack
        set_items(self.fs_dd, ['FAT32' if fat else 'Défini par l\'image'])
        if (k, hack) != self.mode:   # nom de volume par défaut, comme Rufus
            self.mode = (k, hack)
            self.label_ent.set_text('MACRECOVERY' if hack else fat_label(self.img_label, 'WINUSB')
                                    if k == 'windows' else self.img_label if k else '')
        self.efi_field.set_visible(hack)
        newer = k == 'mac-dl' and not hack and self.opt_dd.get_selected() < 6
        self.hint.set_label('Mac Intel : fiable jusqu\'à Catalina. Si cette version est refusée, '
                            'choisis « Hackintosh (OpenCore) » : la clé n\'est pas effacée avant.' if newer else '')
        self.hint.set_visible(newer)
        self.updating = False

        self.dev_dd.set_sensitive(idle and bool(self.devices))
        self.boot_dd.set_sensitive(idle)
        self.sel_btn.set_sensitive(idle and k != 'mac-dl')
        self.hash_btn.set_sensitive(idle and bool(self.image) and k != 'mac-dl')
        self.opt_dd.set_sensitive(idle)
        self.scheme_dd.set_sensitive(idle and k == 'windows')
        self.target_dd.set_sensitive(idle and mac)
        self.label_ent.set_sensitive(idle and fat)
        self.verify_chk.set_sensitive(idle and k == 'linux')
        self.all_chk.set_sensitive(idle)
        self.start_btn.set_sensitive(idle and bool(self.sel_dev()) and bool(self.backend) and k is not None)
        self.close_btn.set_label('ANNULER' if self.proc else 'FERMER')

    # ───────── écriture ─────────
    def build_args(self):
        k, dev = self.kind(), self.sel_dev()[0]
        args = ['-d', dev]
        args += ['--mac-recovery', MACOS[self.opt_dd.get_selected()][0]] if k == 'mac-dl' else ['-i', self.image]
        if k == 'windows':
            args += ['-s', 'gpt' if self.scheme_dd.get_selected() == 1 else 'mbr']
            if self.opt_dd.get_selected() == 1:
                args.append('--win11-bypass')
        if k in ('mac', 'mac-dl'):
            hack = self.target_dd.get_selected() == 1
            args += ['--mac-mode', 'opencore' if hack else 'raw']
            if hack and self.efi:
                args += ['--efi', self.efi]
        if self.label_ent.get_sensitive() and self.label_ent.get_text().strip():
            args += ['-L', self.label_ent.get_text().strip()]
        if self.verify_chk.get_sensitive() and self.verify_chk.get_active():
            args.append('-V')
        if self.all_chk.get_active():
            args.append('-f')
        return args

    def on_start(self, _btn):
        if not self.sel_dev():
            return
        d, _size, model = self.sel_dev()
        self.alert(f'AVERTISSEMENT : TOUTES LES DONNÉES DU PÉRIPHÉRIQUE « {model} ({d}) » VONT ÊTRE DÉTRUITES.',
                   'Pour continuer, cliquez sur OK. Pour quitter, cliquez sur Annuler.',
                   ['Annuler', 'OK'], lambda i: i == 1 and self.run(self.build_args()))

    def run(self, args):
        cmd = [self.backend, '--gui'] + args
        if os.geteuid() != 0:
            pk = shutil.which('pkexec', path=SYS_PATH)
            if not pk:
                self.alert('pkexec introuvable', 'Installe polkit (pkexec) pour obtenir les droits administrateur.')
                return
            cmd = [pk] + cmd
        self.log('$ ' + ' '.join(cmd))
        try:
            self.proc = subprocess.Popen(cmd, stdin=subprocess.PIPE, stdout=subprocess.PIPE,
                                         stderr=subprocess.STDOUT, start_new_session=True,
                                         env={'PATH': SYS_PATH, 'LANG': 'C.UTF-8'})
        except OSError as e:
            self.alert('Impossible de lancer le moteur', str(e))
            return
        self.busy, self.cancelled, self.error, self.warnings = True, False, '', []
        self.phase, self.frac, self.total, self.t0 = 'Autorisation administrateur', None, None, time.monotonic()
        self.set_bar(0, 'Autorisation administrateur…')
        self.update_ui()
        threading.Thread(target=self.reader, daemon=True).start()

    def reader(self):
        fd, buf = self.proc.stdout.fileno(), b''
        while chunk := os.read(fd, 65536):
            buf += chunk
            *parts, buf = re.split(rb'[\r\n]', buf)
            for p in parts:
                if p.strip():
                    GLib.idle_add(self.on_output, p.decode('utf-8', 'replace').strip())
        if buf.strip():
            GLib.idle_add(self.on_output, buf.decode('utf-8', 'replace').strip())
        GLib.idle_add(self.on_done, self.proc.wait())

    def on_output(self, s):
        if len(s) > 2 and s[0] == '@' and s[2] == ' ':
            tag, msg = s[1], s[3:]
            if tag == 'I':
                self.phase, self.frac, self.total, self.fmax = msg.rstrip('…. '), None, None, 0
                self.set_bar(0, self.phase)
                self.log(msg)
            elif tag == 'O':
                self.log('✓ ' + msg)
            elif tag == 'W':
                self.warnings.append(msg)
                self.log('⚠ ' + msg)
            elif tag == 'E':
                self.error = msg
                self.log('✗ ' + msg)
            elif tag == 'T' and msg.isdigit():
                self.total = int(msg) or None
            elif tag == 'F' and msg.isdigit():
                left = int(msg)
                self.fmax = max(self.fmax, left)
                self.progress(1 - left / self.fmax if self.fmax else 1)
            return False
        m = RE_DD.match(s)
        if m and self.total:
            self.progress(int(m[1]) / self.total)
            return False
        m = RE_PCT.search(s)
        if m and not s.startswith('Calcul'):
            self.progress(float(m[1].replace(',', '.')) / 100)
            return False
        self.log(s)
        return False

    def progress(self, frac):
        self.frac = max(0.0, min(1.0, frac))
        self.set_bar(self.frac, f'{self.phase} : {100 * self.frac:.1f} %')

    def tick(self):
        if self.proc:
            if self.frac is None:
                self.bar.pulse()
            s = int(time.monotonic() - self.t0)
            self.clock.set_label(f'{s // 3600:02d}:{s // 60 % 60:02d}:{s % 60:02d}')
        return True

    def on_done(self, rc):
        self.proc, self.busy = None, False
        if self.cancelled:
            self.set_bar(0, 'ANNULÉ')
            self.status.set_label('Opération annulée')
        elif rc == 0:
            self.set_bar(1, 'PRÊT')
            self.status.set_label(f'Terminé en {self.clock.get_label()}')
            if self.warnings:
                self.alert('Clé prête, avec des remarques', '\n\n'.join(self.warnings))
        elif rc in (126, 127) and not self.error:
            self.set_bar(0, 'PRÊT')
            self.status.set_label('Autorisation refusée ou annulée')
        else:
            self.set_bar(0, 'ERREUR')
            self.status.set_label('Échec — voir le journal')
            self.alert('Erreur', self.error or f'Le moteur s\'est arrêté (code {rc}). Voir le journal.')
        self.log(f'— fin (code {rc})')
        self.refresh_devices(force=True)
        self.update_ui()
        return False

    # ───────── fermeture / annulation ─────────
    def cancel(self, idx):
        if idx == 1 and self.proc:
            self.cancelled = True
            self.set_bar(None, 'Annulation…')
            try:
                self.proc.stdin.close()   # le moteur détecte la fermeture et arrête tout proprement
            except OSError:
                pass

    def ask_cancel(self):
        self.alert('Annuler l\'opération en cours ?',
                   'La clé sera inutilisable tant qu\'elle n\'aura pas été réécrite.', ['Continuer', 'Annuler'],
                   self.cancel)

    def on_close(self, _btn):
        if self.proc:
            self.ask_cancel()
        else:
            self.close()

    def on_close_request(self, _win):
        if self.proc:
            self.ask_cancel()
            return True
        return False

    # ───────── à propos / journal ─────────
    def on_about(self, _btn):
        Gtk.AboutDialog(transient_for=self, modal=True, program_name='LinXfus', version=VERSION,
                        logo_icon_name=APP_ID, website='https://github.com/Joss943/Linxfus',
                        comments='Clés USB bootables Windows, macOS et Linux, comme Rufus.',
                        license_type=Gtk.License.MIT_X11, authors=['Josselin Lerendu']).present()

    def on_log(self, _btn):
        if self.log_win:
            self.log_win.present()
            return
        tv = Gtk.TextView(buffer=self.log_buf, editable=False, monospace=True, wrap_mode=Gtk.WrapMode.WORD_CHAR,
                          top_margin=8, bottom_margin=8, left_margin=8, right_margin=8)
        sw = Gtk.ScrolledWindow(child=tv, vexpand=True)
        copy = Gtk.Button(label='Copier le journal')
        copy.connect('clicked', lambda *_: self.copy(
            self.log_buf.get_text(self.log_buf.get_start_iter(), self.log_buf.get_end_iter(), False)))
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6, margin_bottom=8, margin_end=8)
        box.append(sw)
        copy.set_halign(Gtk.Align.END)
        box.append(copy)
        self.log_win = Gtk.Window(title='Journal LinXfus', transient_for=self, default_width=640,
                                  default_height=420, child=box, hide_on_close=True)
        self.log_win.present()


class App(Gtk.Application):
    def __init__(self):
        super().__init__(application_id=APP_ID, flags=Gio.ApplicationFlags.HANDLES_OPEN)
        self.win = None

    def do_startup(self):
        Gtk.Application.do_startup(self)
        css = Gtk.CssProvider()
        if hasattr(css, 'load_from_string'):
            css.load_from_string(CSS.decode())
        else:
            css.load_from_data(CSS, -1)
        Gtk.StyleContext.add_provider_for_display(Gdk.Display.get_default(), css,
                                                  Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
        Gtk.Window.set_default_icon_name(APP_ID)

    def do_activate(self):
        if not self.win:
            self.win = Window(self)
        self.win.present()

    def do_open(self, files, _n, _hint):
        self.do_activate()
        if files and files[0].get_path():
            self.win.set_image(files[0].get_path())


if __name__ == '__main__':
    sys.exit(App().run(sys.argv))
