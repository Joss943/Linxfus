#!/usr/bin/env bash
# LinXfus — l'équivalent de Rufus pour Linux.
# Crée des clés USB bootables Windows, macOS et Linux depuis le terminal.
# https://github.com/Joss943/linxfus — Licence MIT
set -Eeuo pipefail

VERSION="1.0.0"
PROG="linxfus"
OC_RAW="https://raw.githubusercontent.com/acidanthera/OpenCorePkg/master/Utilities/macrecovery"
CACHE_DIR="/var/cache/linxfus"
FAT32_MAX=${LINXFUS_FAT32_MAX:-4294967295}   # taille max d'un fichier sur FAT32 (octets)
SWM_CHUNK_MB=${LINXFUS_SWM_MB:-3800}          # taille des morceaux install.swm (Mo)

# ───────────────────────────── affichage ─────────────────────────────
if [[ -t 1 ]]; then
  R=$'\e[31m' G=$'\e[32m' Y=$'\e[33m' B=$'\e[34m' W=$'\e[1m' N=$'\e[0m'
else
  R='' G='' Y='' B='' W='' N=''
fi
info() { printf '%s[*]%s %s\n' "$B" "$N" "$*"; }
ok()   { printf '%s[✓]%s %s\n' "$G" "$N" "$*"; }
warn() { printf '%s[!]%s %s\n' "$Y" "$N" "$*" >&2; }
die()  { printf '%s[✗]%s %s\n' "$R" "$N" "$*" >&2; exit 1; }
hsize() { numfmt --to=iec-i --suffix=o --format='%.1f' "$1" 2>/dev/null || echo "$1 o"; }

usage() {
  cat <<EOF
${W}LinXfus $VERSION${N} — clés USB bootables Windows / macOS / Linux

${W}Usage${N}
  sudo $PROG                                   mode interactif
  sudo $PROG -i IMAGE -d /dev/sdX [options]    mode direct
  $PROG -l                                     liste les clés USB

${W}Général${N}
  -i, --image FICHIER     ISO / IMG / DMG (img.xz, .gz, .zst, .bz2 acceptés)
  -d, --device DISQUE     clé cible, disque entier (/dev/sdX)
  -t, --type TYPE         auto | windows | mac | linux     (défaut : auto)
  -L, --label NOM         nom du volume (Windows / OpenCore)
      --sha256 HASH       vérifie l'image avant écriture
  -V, --verify            relit la clé après écriture (modes dd)
  -y, --yes               pas de confirmation (dangereux)
  -f, --force             autorise un disque non amovible
  -l, --list              liste les clés USB détectées
      --deps              installe les dépendances (dnf / apt / pacman)
  -h, --help | -v, --version

${W}Windows${N}  (FAT32, install.wim > 4 Go découpé automatiquement)
  -s, --scheme mbr|gpt    mbr = BIOS + UEFI (défaut) · gpt = UEFI seul
      --no-bios           ne pas installer le chargeur BIOS (GRUB)
      --win11-bypass      saute les contrôles TPM / Secure Boot / RAM

${W}macOS${N}
      --mac-recovery VER  télécharge la recovery depuis Apple :
                          elcapitan sierra highsierra mojave catalina
                          bigsur monterey ventura sonoma sequoia tahoe
      --mac-mode MODE     raw      = image disque brute, Mac Intel (défaut)
                          opencore = FAT32 + com.apple.recovery.boot (Hackintosh)
      --efi DOSSIER       dossier EFI OpenCore à copier (mode opencore)

${W}Exemples${N}
  sudo $PROG -i Win11.iso -d /dev/sdb --win11-bypass
  sudo $PROG -i Fedora-Workstation-Live.iso -d /dev/sdb -V
  sudo $PROG --mac-recovery sonoma -d /dev/sdb
  sudo $PROG --mac-recovery sequoia --mac-mode opencore --efi ./EFI -d /dev/sdb
EOF
}

# ───────────────────────────── options ─────────────────────────────
IMAGE="" DEVICE="" TYPE="auto" SCHEME="mbr" LABEL="" SHA="" VERIFY=0 YES=0 FORCE=0
NO_BIOS=0 WIN11_BYPASS=0 MAC_RECOVERY="" MAC_MODE="raw" EFI_DIR="" ACTION="write"
ARGS=("$@")

while (($#)); do
  case $1 in
    -i|--image)      IMAGE=${2:?}; shift ;;
    -d|--device)     DEVICE=${2:?}; shift ;;
    -t|--type)       TYPE=${2:?}; shift ;;
    -s|--scheme)     SCHEME=${2:?}; shift ;;
    -L|--label)      LABEL=${2:?}; shift ;;
    --sha256)        SHA=${2:?}; shift ;;
    -V|--verify)     VERIFY=1 ;;
    -y|--yes)        YES=1 ;;
    -f|--force)      FORCE=1 ;;
    --no-bios)       NO_BIOS=1 ;;
    --win11-bypass)  WIN11_BYPASS=1 ;;
    --mac-recovery)  MAC_RECOVERY=${2:?}; shift ;;
    --mac-mode)      MAC_MODE=${2:?}; shift ;;
    --efi)           EFI_DIR=${2:?}; shift ;;
    -l|--list)       ACTION="list" ;;
    --deps)          ACTION="deps" ;;
    -h|--help)       usage; exit 0 ;;
    -v|--version)    echo "$PROG $VERSION"; exit 0 ;;
    *)               die "Option inconnue : $1 (voir --help)" ;;
  esac
  shift
done

[[ $TYPE =~ ^(auto|windows|mac|linux)$ ]] || die "--type : auto | windows | mac | linux"
[[ $SCHEME =~ ^(mbr|gpt)$ ]]              || die "--scheme : mbr | gpt"
[[ $MAC_MODE =~ ^(raw|opencore)$ ]]       || die "--mac-mode : raw | opencore"
[[ -n $MAC_RECOVERY ]] && TYPE="mac"

# ───────────────────────────── utilitaires ─────────────────────────────
need() {
  local c miss=()
  for c in "$@"; do command -v "$c" >/dev/null 2>&1 || miss+=("$c"); done
  ((${#miss[@]} == 0)) || die "Commande(s) manquante(s) : ${miss[*]} → sudo $PROG --deps"
}

# Nom de la 1re partition : /dev/sdb → /dev/sdb1, /dev/mmcblk0 → /dev/mmcblk0p1
part1() { if [[ $1 =~ [0-9]$ ]]; then echo "${1}p1"; else echo "${1}1"; fi; }

dev_size()  { blockdev --getsize64 "$1"; }
dev_model() {
  local b=${1##*/} m=""
  [[ -r /sys/block/$b/device/vendor ]] && m=$(<"/sys/block/$b/device/vendor")
  [[ -r /sys/block/$b/device/model ]]  && m+=" $(<"/sys/block/$b/device/model")"
  m=$(echo "$m" | xargs 2>/dev/null || true)
  echo "${m:-inconnu}"
}
is_removable() {
  local b=${1##*/}
  [[ -e /sys/block/$b ]] || return 1
  [[ $(readlink -f "/sys/block/$b") == */usb* ]] && return 0
  [[ $(cat "/sys/block/$b/removable" 2>/dev/null) == 1 ]] && return 0
  [[ $b == mmcblk* ]] && return 0
  return 1
}

# Disques qui portent le système (/, /boot, /home, swap) — jamais touchés.
system_disks() {
  local mp src
  {
    for mp in / /boot /boot/efi /efi /home /usr /var; do
      src=$(findmnt -nvo SOURCE "$mp" 2>/dev/null) || continue
      [[ $src == /dev/* ]] && echo "$src"
    done
    swapon --noheadings --show=NAME 2>/dev/null || true
  } | while read -r src; do
    lsblk -rnspo NAME,TYPE "$src" 2>/dev/null | awk '$2=="disk"{print $1}'
  done | sort -u
}

usb_disks() {  # affiche les disques amovibles, un par ligne
  local d sys
  sys=$(system_disks)
  for d in /sys/block/sd* /sys/block/mmcblk[0-9]*; do
    [[ -e $d ]] || continue
    d=/dev/${d##*/}
    [[ $d == *boot* || $d == *rpmb* ]] && continue
    is_removable "$d" || continue
    grep -qx "$d" <<<"$sys" && continue
    (( $(dev_size "$d" 2>/dev/null || echo 0) > 0 )) || continue
    echo "$d"
  done
}

list_disks() {
  local d found=0
  printf '%s%-14s %10s  %s%s\n' "$W" "DISQUE" "TAILLE" "MODÈLE" "$N"
  while read -r d; do
    [[ -n $d ]] || continue
    found=1
    printf '%-14s %10s  %s\n' "$d" "$(hsize "$(dev_size "$d")")" "$(dev_model "$d")"
  done < <(usb_disks)
  ((found)) || warn "Aucune clé USB détectée."
}

install_deps() {
  if command -v dnf >/dev/null; then
    dnf install -y parted dosfstools rsync wimlib-utils grub2-tools grub2-pc-modules \
      dmg2img python3 curl xz zstd bzip2 util-linux
  elif command -v apt-get >/dev/null; then
    apt-get update && apt-get install -y parted dosfstools rsync wimtools grub-pc-bin grub2-common \
      grub-common dmg2img python3 curl xz-utils zstd bzip2 util-linux
  elif command -v pacman >/dev/null; then
    pacman -S --needed --noconfirm parted dosfstools rsync wimlib grub python curl xz zstd bzip2 util-linux
    warn "dmg2img est dans l'AUR (yay -S dmg2img) — utile seulement pour macOS en mode raw."
  else
    die "Gestionnaire de paquets non géré. À installer : parted dosfstools rsync wimlib grub(i386-pc) dmg2img python3 curl"
  fi
  ok "Dépendances installées."
}

# ───────────────────────────── nettoyage ─────────────────────────────
WORK="" ISO_MNT="" USB_MNT=""
cleanup() {
  set +e
  local m busy=0
  for m in "$USB_MNT" "$ISO_MNT"; do
    [[ -n $m ]] && mountpoint -q "$m" && { umount "$m" 2>/dev/null || umount -l "$m" 2>/dev/null || busy=1; }
  done
  if [[ -n $WORK && -d $WORK ]]; then
    if ((busy)); then warn "Point de montage occupé, $WORK conservé."
    else rm -rf --one-file-system "$WORK"; fi
  fi
}
trap cleanup EXIT
trap 'echo; die "Interrompu."' INT TERM

# ───────────────────────────── ISO / détection ─────────────────────────────
mount_iso() {
  [[ -n $ISO_MNT ]] && mountpoint -q "$ISO_MNT" && return 0
  ISO_MNT="$WORK/iso"; mkdir -p "$ISO_MNT"
  mount -o loop,ro "$IMAGE" "$ISO_MNT" 2>/dev/null || die "Impossible de monter l'ISO $IMAGE"
}

# Chemin réel (insensible à la casse) d'un fichier dans l'ISO montée.
iso_find() { find "$ISO_MNT" -maxdepth 3 -ipath "$ISO_MNT/$1" -print -quit 2>/dev/null; }

detect_type() {  # renseigne TYPE (pas de sous-shell : le montage doit rester visible)
  case ${IMAGE,,} in
    *.dmg) TYPE=mac; return ;;
    *.xz|*.gz|*.zst|*.bz2|*.img|*.raw|*.bin) TYPE=linux; return ;;
  esac
  mount_iso
  if [[ -n $(iso_find "sources/boot.wim") || -n $(iso_find "sources/install.wim") || -n $(iso_find "sources/install.esd") ]]; then
    TYPE=windows
  elif [[ $(blkid -o value -s TYPE "$IMAGE" 2>/dev/null) == hfs* ]]; then
    TYPE=mac
  else
    TYPE=linux
  fi
}

is_hybrid() {  # signature MBR 0x55AA → ISO « isohybride », écrivable avec dd
  [[ $(od -An -tx1 -j510 -N2 "$1" | tr -d ' \n') == 55aa ]]
}

is_compressed() { case ${1,,} in *.xz|*.gz|*.zst|*.bz2) return 0 ;; *) return 1 ;; esac; }

decompress() {
  case ${1,,} in
    *.xz)  need xz;    xz -dc -- "$1" ;;
    *.gz)  need gzip;  gzip -dc -- "$1" ;;
    *.zst) need zstd;  zstd -dc -- "$1" ;;
    *.bz2) need bzip2; bzip2 -dc -- "$1" ;;
    *)     cat -- "$1" ;;
  esac
}

# ───────────────────────────── préparation de la clé ─────────────────────────────
unmount_device() {
  local p
  for p in $(lsblk -lnpo NAME "$DEVICE" | tac); do
    umount "$p" 2>/dev/null || true
    swapoff "$p" 2>/dev/null || true
  done
  if grep -qE "^${DEVICE}(p?[0-9]+)? " /proc/mounts; then
    die "$DEVICE est encore monté (fichier ouvert ?). Ferme ce qui l'utilise et relance."
  fi
}

wait_part() {
  local p=$1 i
  command -v partprobe >/dev/null && partprobe "$DEVICE" 2>/dev/null || true
  command -v udevadm >/dev/null && udevadm settle 2>/dev/null || true
  for i in {1..20}; do
    [[ -b $p ]] && return 0
    ((i == 5)) && partx -u "$DEVICE" 2>/dev/null || true
    sleep 0.5
  done
  die "La partition $p n'apparaît pas."
}

fat_label() {  # majuscules, 11 caractères max, caractères sûrs
  local l
  l=$(printf '%s' "$1" | tr '[:lower:]' '[:upper:]' | tr -cd 'A-Z0-9_-' | cut -c1-11)
  echo "${l:-$2}"
}

# Table de partitions + une seule partition FAT32. $1 = mbr|gpt, $2 = label
make_fat32() {
  local scheme=$1 label=$2 p
  info "Partitionnement ($scheme) + FAT32 « $label »…"
  wipefs -af "$DEVICE" >/dev/null
  if [[ $scheme == gpt ]]; then
    parted -s "$DEVICE" mklabel gpt mkpart "$label" fat32 4MiB 100% set 1 msftdata on
  else
    parted -s "$DEVICE" mklabel msdos mkpart primary fat32 4MiB 100% set 1 boot on set 1 lba on
  fi
  p=$(part1 "$DEVICE")
  wait_part "$p"
  wipefs -af "$p" >/dev/null 2>&1 || true
  mkfs.vfat -F 32 -n "$label" "$p" >/dev/null
  USB_MNT="$WORK/usb"; mkdir -p "$USB_MNT"
  mount -t vfat -o flush,utf8,quiet "$p" "$USB_MNT"
}

# Copies sans métadonnées (FAT32 ne gère ni droits ni propriétaires).
copy_file() {  # $1 = source, $2 = fichier destination
  if command -v rsync >/dev/null; then rsync --info=progress2 -- "$1" "$2"; else cat -- "$1" >"$2"; fi
}
copy_tree() {  # $1 = dossier source, $2 = dossier destination, puis exclusions rsync
  local s=$1 d=$2 f; shift 2
  mkdir -p "$d"
  if command -v rsync >/dev/null; then
    rsync -r --no-inc-recursive --info=progress2 "$@" -- "$s/" "$d/"
    return
  fi
  (cd "$s" && find . -mindepth 1 -type d -print0) | while IFS= read -r -d '' f; do mkdir -p "$d/$f"; done
  (cd "$s" && find . -type f -print0) | while IFS= read -r -d '' f; do
    (( $(stat -c %s "$s/$f") > FAT32_MAX )) && continue   # gros WIM/ESD : traités à part
    cat -- "$s/$f" >"$d/$f"
  done
}

finish() {
  info "Vidage des caches vers la clé (peut prendre quelques minutes)…"
  sync
  [[ -n $USB_MNT ]] && mountpoint -q "$USB_MNT" && umount "$USB_MNT"
  blockdev --flushbufs "$DEVICE" 2>/dev/null || true
  ok "Clé prête : $DEVICE — tu peux la retirer."
}

# ───────────────────────────── écriture brute (dd) ─────────────────────────────
write_raw() {
  local img=$1 size=""
  if ! is_compressed "$img"; then
    size=$(stat -Lc %s "$img")
    (( size <= $(dev_size "$DEVICE") )) || die "Image ($(hsize "$size")) plus grande que la clé."
  fi
  info "Écriture de $(basename "$img") sur $DEVICE…"
  wipefs -af "$DEVICE" >/dev/null
  decompress "$img" | dd of="$DEVICE" bs=4M iflag=fullblock oflag=direct conv=fsync status=progress
  sync
  if ((VERIFY)); then
    info "Vérification (relecture de la clé)…"
    size=${size:-$(decompress "$img" | wc -c)}
    blockdev --flushbufs "$DEVICE"
    if cmp -n "$size" <(decompress "$img") "$DEVICE"; then ok "Vérification OK."; else die "Vérification ÉCHOUÉE : la clé est peut-être défectueuse."; fi
  fi
  finish
}

# ───────────────────────────── Linux ─────────────────────────────
write_linux() {
  if [[ ${IMAGE,,} == *.iso ]] && ! is_hybrid "$IMAGE"; then
    warn "Cette ISO n'est pas « isohybride » : écrite telle quelle, elle risque de ne pas démarrer."
    ((YES)) || { read -rp "Continuer quand même ? [o/N] " a; [[ ${a,,} == o* ]] || exit 1; }
  fi
  write_raw "$IMAGE"
}

# ───────────────────────────── Windows ─────────────────────────────
write_unattend() {
  local f=$USB_MNT/autounattend.xml a cmds="" i=1 k
  for k in BypassTPMCheck BypassSecureBootCheck BypassRAMCheck; do
    cmds+="        <RunSynchronousCommand wcm:action=\"add\"><Order>$i</Order><Path>reg add HKLM\\SYSTEM\\Setup\\LabConfig /v $k /t REG_DWORD /d 1 /f</Path></RunSynchronousCommand>"$'\n'
    ((i++))
  done
  {
    echo '<?xml version="1.0" encoding="utf-8"?>'
    echo '<unattend xmlns="urn:schemas-microsoft-com:unattend" xmlns:wcm="http://schemas.microsoft.com/WMIConfig/2002/State">'
    echo '  <settings pass="windowsPE">'
    for a in amd64 arm64; do
      echo "    <component name=\"Microsoft-Windows-Setup\" processorArchitecture=\"$a\" publicKeyToken=\"31bf3856ad364e35\" language=\"neutral\" versionScope=\"nonSxS\">"
      echo '      <RunSynchronous>'
      printf '%s' "$cmds"
      echo '      </RunSynchronous>'
      echo '    </component>'
    done
    echo '  </settings>'
    echo '</unattend>'
  } >"$f"
  ok "autounattend.xml ajouté (contournement TPM / Secure Boot / RAM)."
}

install_bios_loader() {
  local gi="" d="" x cfgdir
  gi=$(command -v grub-install || command -v grub2-install || true)
  for x in /usr/lib/grub/i386-pc /usr/lib/grub2/i386-pc; do [[ -e $x/ntldr.mod ]] && { d=$x; break; }; done
  if [[ -z $gi || -z $d ]]; then
    warn "GRUB i386-pc absent → démarrage BIOS non installé (UEFI OK). Installe : sudo $PROG --deps"
    return 0
  fi
  [[ -n $(iso_find bootmgr) ]] || { warn "bootmgr absent de l'ISO → démarrage BIOS non installé."; return 0; }
  info "Installation du chargeur BIOS (GRUB → bootmgr)…"
  "$gi" --target=i386-pc --directory="$d" --boot-directory="$USB_MNT" --force "$DEVICE" >/dev/null 2>&1 \
    || { warn "grub-install a échoué → démarrage BIOS indisponible (UEFI OK)."; return 0; }
  cfgdir=$USB_MNT/grub; [[ -d $USB_MNT/grub2 ]] && cfgdir=$USB_MNT/grub2
  printf '%s\n' '# LinXfus : démarrage BIOS de Windows (bootmgr)' 'ntldr /bootmgr' 'boot' >"$cfgdir/grub.cfg"
  ok "Démarrage BIOS (Legacy/CSM) installé."
}

write_windows() {
  need parted mkfs.vfat wipefs
  mount_iso
  local wim esd total rel big=0 label
  wim=$(iso_find "sources/install.wim")
  esd=$(iso_find "sources/install.esd")
  [[ -n $wim || -n $esd || -n $(iso_find "sources/boot.wim") ]] || die "Ce n'est pas une ISO d'installation Windows."

  total=$(du -sb "$ISO_MNT" | cut -f1)
  (( total + 64*1024*1024 < $(dev_size "$DEVICE") )) || die "Clé trop petite : il faut au moins $(hsize $((total + 64*1024*1024)))."

  if [[ -n $wim ]] && (( $(stat -c %s "$wim") > FAT32_MAX )); then
    big=1; need wimlib-imagex
  fi
  if [[ -n $esd ]] && (( $(stat -c %s "$esd") > FAT32_MAX )); then
    need wimlib-imagex
  fi
  # Autre fichier > 4 Go (hors install.wim/esd) → impossible en FAT32
  if find "$ISO_MNT" -type f -size +"${FAT32_MAX}"c ! -iname 'install.wim' ! -iname 'install.esd' | grep -q .; then
    die "L'ISO contient un fichier > 4 Go impossible à placer sur FAT32."
  fi

  label=$(fat_label "${LABEL:-$(blkid -o value -s LABEL "$IMAGE" 2>/dev/null)}" WINUSB)
  unmount_device
  make_fat32 "$SCHEME" "$label"

  info "Copie des fichiers Windows ($(hsize "$total"))…"
  local excl=()
  [[ -n $wim ]] && (( big )) && excl+=("--exclude=/${wim#"$ISO_MNT"/}")
  [[ -n $esd ]] && (( $(stat -c %s "$esd") > FAT32_MAX )) && excl+=("--exclude=/${esd#"$ISO_MNT"/}")
  copy_tree "$ISO_MNT" "$USB_MNT" "${excl[@]}"

  local src dst
  for rel in "$wim" "$esd"; do
    [[ -n $rel ]] && (( $(stat -c %s "$rel") > FAT32_MAX )) || continue
    src=$rel
    dst=$USB_MNT/${rel#"$ISO_MNT"/}; dst=${dst%.*}.swm
    if [[ ${rel,,} == *.esd ]]; then  # un ESD (compression solide) ne se découpe pas : conversion WIM d'abord
      info "install.esd > 4 Go → conversion en WIM…"
      src=$WORK/install.wim
      wimlib-imagex export "$rel" all "$src" --compress=LZX
    fi
    info "$(basename "$src") > 4 Go → découpage en morceaux de ${SWM_CHUNK_MB} Mo…"
    wimlib-imagex split "$src" "$dst" "$SWM_CHUNK_MB"
  done

  ((WIN11_BYPASS)) && write_unattend
  if [[ $SCHEME == mbr ]] && ((!NO_BIOS)); then install_bios_loader; fi
  finish
  [[ $SCHEME == gpt ]] && info "Schéma GPT : démarre la clé en mode UEFI uniquement."
  return 0
}

# ───────────────────────────── macOS ─────────────────────────────
mac_board() {  # identifiants Apple publiés par OpenCorePkg (recovery_urls.txt)
  case ${1,,} in
    elcapitan|10.11)  echo "Mac-FFE5EF870D7BA81A 00000000000GQRX00 default" ;;
    sierra|10.12)     echo "Mac-77F17D7DA9285301 00000000000J0DX00 default" ;;
    highsierra|10.13) echo "Mac-7BA5B2D9E42DDD94 00000000000J80300 default" ;;
    mojave|10.14)     echo "Mac-7BA5B2DFE22DDD8C 00000000000KXPG00 default" ;;
    catalina|10.15)   echo "Mac-00BE6ED71E35EB86 00000000000000000 default" ;;
    bigsur|11)        echo "Mac-2BD1B31983FE1663 00000000000000000 default" ;;
    monterey|12)      echo "Mac-E43C1C25D4880AD6 00000000000000000 default" ;;
    ventura|13)       echo "Mac-B4831CEBD52A0C4C 00000000000000000 default" ;;
    sonoma|14)        echo "Mac-827FAC58A8FDFA22 00000000000000000 default" ;;
    sequoia|15)       echo "Mac-7BA5B2D9E42DDD94 00000000000000000 default" ;;
    tahoe|26)         echo "Mac-CFF7D910A743CAAF 00000000000000000 latest" ;;
    *) return 1 ;;
  esac
}
MAC_VERSIONS=(elcapitan sierra highsierra mojave catalina bigsur monterey ventura sonoma sequoia tahoe)

MAC_DMG=""
download_mac_recovery() {  # renseigne MAC_DMG
  need python3 curl
  local ver=${1,,} bid mlb os dir out
  read -r bid mlb os < <(mac_board "$ver") || die "Version macOS inconnue : $1 (${MAC_VERSIONS[*]})"
  dir=$CACHE_DIR/macos-$ver; out=$dir/com.apple.recovery.boot
  MAC_DMG=$(find "$out" -maxdepth 1 -iname '*.dmg' -print -quit 2>/dev/null || true)
  if [[ -n $MAC_DMG ]]; then
    info "Recovery $ver déjà en cache : $out"
    return 0
  fi
  mkdir -p "$dir"
  info "Téléchargement de macrecovery (OpenCorePkg)…"
  curl -fsSL -o "$dir/macrecovery.py" "$OC_RAW/macrecovery.py" || die "Téléchargement de macrecovery.py impossible."
  curl -fsSL -o "$dir/boards.json"    "$OC_RAW/boards.json"    || true
  info "Téléchargement de la recovery macOS $ver depuis les serveurs Apple…"
  python3 -I "$dir/macrecovery.py" -b "$bid" -m "$mlb" -os "$os" -o "$out" download \
    || { rm -rf "$out"; die "Échec du téléchargement de la recovery."; }
  MAC_DMG=$(find "$out" -maxdepth 1 -iname '*.dmg' -print -quit)
  [[ -n $MAC_DMG ]] || die "Aucun .dmg récupéré."
  ok "Recovery téléchargée et vérifiée (chunklist) : $MAC_DMG"
}

write_mac() {
  local img=$IMAGE
  if [[ -n $MAC_RECOVERY ]]; then download_mac_recovery "$MAC_RECOVERY"; img=$MAC_DMG; fi
  [[ -f $img ]] || die "Image introuvable : $img"
  unmount_device

  if [[ $MAC_MODE == opencore ]]; then
    need parted mkfs.vfat wipefs
    [[ ${img,,} == *.dmg ]] || die "Le mode opencore attend un BaseSystem.dmg / RecoveryImage.dmg."
    local cnk=${img%.*}.chunklist
    make_fat32 gpt "$(fat_label "${LABEL:-}" MACRECOVERY)"
    mkdir -p "$USB_MNT/com.apple.recovery.boot"
    info "Copie de la recovery dans com.apple.recovery.boot…"
    copy_file "$img" "$USB_MNT/com.apple.recovery.boot/$(basename "$img")"
    if [[ -f $cnk ]]; then copy_file "$cnk" "$USB_MNT/com.apple.recovery.boot/$(basename "$cnk")"
    else warn "Pas de .chunklist à côté du .dmg (OpenCore peut le réclamer)."; fi
    if [[ -n $EFI_DIR ]]; then
      [[ -d $EFI_DIR ]] || die "Dossier EFI introuvable : $EFI_DIR"
      info "Copie du dossier EFI OpenCore…"
      copy_tree "$EFI_DIR" "$USB_MNT/EFI"
    else
      warn "Pas de --efi : ajoute ton dossier EFI OpenCore à la racine de la clé avant de booter."
    fi
    finish
    return 0
  fi

  # Mode raw : image disque brute → Mac Intel (touche Option ⌥ au démarrage)
  if [[ ${img,,} == *.dmg ]]; then
    need dmg2img
    info "Conversion DMG → image disque et écriture directe sur $DEVICE…"
    wipefs -af "$DEVICE" >/dev/null
    if ! dmg2img -i "$img" -o "$DEVICE"; then
      die "dmg2img a échoué (compression LZFSE des DMG récents ?). Essaie : --mac-mode opencore"
    fi
    finish
  else
    write_raw "$img"
  fi
  info "Sur le Mac : maintiens ⌥ Option au démarrage et choisis la clé (Mac Intel uniquement)."
}

# ───────────────────────────── mode interactif ─────────────────────────────
interactive() {
  local a i disks=()
  echo "${W}═══ LinXfus $VERSION — clé USB bootable ═══${N}"
  if [[ -z $IMAGE && -z $MAC_RECOVERY ]]; then
    echo "Chemin de l'image (ISO/IMG/DMG, Tab pour compléter) ou « mac » pour télécharger une recovery macOS :"
    read -erp "> " a
    a="${a%"${a##*[![:space:]]}"}"                 # espaces finaux (glisser-déposer)
    a=${a/#\~/$HOME}; a=${a%\"}; a=${a#\"}; a=${a%\'}; a=${a#\'}
    if [[ ${a,,} == mac ]]; then
      echo "Version macOS :"
      select a in "${MAC_VERSIONS[@]}"; do [[ -n $a ]] && break; done
      MAC_RECOVERY=$a; TYPE=mac
      echo "Usage : 1) Mac Intel (raw)   2) Hackintosh / OpenCore"
      read -rp "> [1] " a; [[ $a == 2 ]] && MAC_MODE=opencore
      if [[ $MAC_MODE == opencore ]]; then
        read -erp "Dossier EFI OpenCore (vide = plus tard) : " a; [[ -n $a ]] && EFI_DIR=${a/#\~/$HOME}
      fi
    else
      IMAGE=$a
    fi
  fi
  if [[ -z $DEVICE ]]; then
    mapfile -t disks < <(usb_disks)
    ((${#disks[@]})) || die "Aucune clé USB détectée. Branche-la et relance."
    echo "Clés détectées :"
    for i in "${!disks[@]}"; do
      printf '  %d) %-12s %10s  %s\n' $((i + 1)) "${disks[i]}" "$(hsize "$(dev_size "${disks[i]}")")" "$(dev_model "${disks[i]}")"
    done
    read -rp "Choix [1] : " a; a=${a:-1}
    [[ $a =~ ^[0-9]+$ ]] && ((a >= 1 && a <= ${#disks[@]})) || die "Choix invalide."
    DEVICE=${disks[a - 1]}
  fi
  INTERACTIVE=1
}

ask_windows_options() {
  local a
  echo "Schéma : 1) MBR — BIOS + UEFI (recommandé)   2) GPT — UEFI uniquement"
  read -rp "> [1] " a; [[ $a == 2 ]] && SCHEME=gpt
  read -rp "Windows 11 : contourner TPM / Secure Boot / RAM ? [o/N] " a
  [[ ${a,,} == o* ]] && WIN11_BYPASS=1
  return 0
}

# ───────────────────────────── principal ─────────────────────────────
if [[ $ACTION == list ]]; then list_disks; exit 0; fi
if ((EUID != 0)); then
  command -v sudo >/dev/null || die "À lancer en root."
  exec sudo -- "$0" "${ARGS[@]}"
fi
if [[ $ACTION == deps ]]; then install_deps; exit 0; fi

need lsblk blockdev wipefs dd findmnt mount umount numfmt
WORK=$(mktemp -d /var/tmp/linxfus.XXXXXX)
INTERACTIVE=0
if [[ ( -z $IMAGE && -z $MAC_RECOVERY ) || -z $DEVICE ]]; then
  [[ -t 0 ]] || die "Image (-i) et clé (-d) requises hors mode interactif. Voir --help."
  interactive
fi

# Image
if [[ -z $MAC_RECOVERY ]]; then
  [[ -f $IMAGE ]] || die "Image introuvable : $IMAGE"
  IMAGE=$(readlink -f "$IMAGE")
  if [[ -n $SHA ]]; then
    info "Calcul du SHA-256…"
    [[ $(sha256sum "$IMAGE" | cut -d' ' -f1) == "${SHA,,}" ]] || die "SHA-256 différent : image corrompue ou mauvaise version."
    ok "SHA-256 conforme."
  fi
  [[ $TYPE == auto ]] && detect_type
fi

# Clé
[[ -b $DEVICE ]] || die "$DEVICE n'est pas un périphérique bloc."
DEVICE=$(readlink -f "$DEVICE")
case $(lsblk -dno TYPE "$DEVICE") in
  disk) ;;
  loop) ((FORCE)) || die "$DEVICE est un loop device (--force pour l'utiliser)." ;;
  *)    die "Donne le disque entier (ex. /dev/sdb), pas une partition." ;;
esac
grep -qx "$DEVICE" <<<"$(system_disks)" && die "$DEVICE contient ton système. Refusé."
if ! is_removable "$DEVICE" && ((!FORCE)); then
  die "$DEVICE n'est pas une clé/disque amovible. --force si tu es sûr."
fi

((INTERACTIVE)) && [[ $TYPE == windows ]] && ask_windows_options

case $TYPE in
  windows)
    desc="Windows — FAT32, MBR (BIOS + UEFI)"
    [[ $SCHEME == gpt ]] && desc="Windows — FAT32, GPT (UEFI)"
    if ((WIN11_BYPASS)); then desc+=", bypass Win11"; fi ;;
  mac)
    desc="macOS — image brute (Mac Intel)"
    [[ $MAC_MODE == opencore ]] && desc="macOS — OpenCore (com.apple.recovery.boot)" ;;
  linux) desc="Linux / image brute — écriture dd" ;;
esac

echo
echo "${W}Récapitulatif${N}"
if [[ -n $MAC_RECOVERY ]]; then
  echo "  Image : recovery macOS « $MAC_RECOVERY » (téléchargée depuis Apple)"
else
  echo "  Image : $(basename "$IMAGE") ($(hsize "$(stat -c %s "$IMAGE")"))"
fi
echo "  Mode  : $desc"
echo "  Clé   : $DEVICE — $(dev_model "$DEVICE") — $(hsize "$(dev_size "$DEVICE")")"
echo "  ${R}${W}⚠ TOUT le contenu de $DEVICE va être effacé.${N}"
if ((!YES)); then
  read -rp "Tape OUI pour continuer : " a
  [[ $a == OUI ]] || die "Annulé."
fi

case $TYPE in
  windows) write_windows ;;
  mac)     write_mac ;;
  linux)   write_linux ;;
esac
