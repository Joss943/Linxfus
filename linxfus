#!/usr/bin/env bash
# LinXfus — l'équivalent de Rufus pour Linux : clés USB bootables Windows, macOS et Linux.
# https://github.com/Joss943/Linxfus — Licence MIT
set -Eeuo pipefail
shopt -s nullglob
IFS=$' \t\n'
umask 077
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

readonly VERSION=2.0.0 PROG=linxfus
readonly FAT32_MAX=4294967295 SWM_MB=3800 CACHE=/var/cache/linxfus
# macrecovery (OpenCorePkg) épinglé sur une version ET une empreinte : rien d'autre n'est exécuté.
readonly OC_URL=https://raw.githubusercontent.com/acidanthera/OpenCorePkg/1.0.8/Utilities/macrecovery/macrecovery.py
readonly OC_SHA=3023a9b4ca79a5255d93c00f25ab5df37e6f938b729b797d9ecea56184b17aff

# ─────────────────────────────── affichage ───────────────────────────────
# --gui : sortie lisible par l'interface graphique (@I info, @O ok, @W alerte, @E erreur, @T taille, @F reste à écrire)
GUI=0; for a; do [[ $a == --gui ]] && GUI=1; done
if [[ -t 1 ]] && ((!GUI)); then R=$'\e[31m' G=$'\e[32m' Y=$'\e[33m' B=$'\e[34m' W=$'\e[1m' N=$'\e[0m'
else R='' G='' Y='' B='' W='' N=''; fi
if ((GUI)); then
  info() { printf '@I %s\n' "$*"; }; ok() { printf '@O %s\n' "$*"; }
  warn() { printf '@W %s\n' "$*"; }; die() { printf '@E %s\n' "$*"; exit 1; }
else
  info() { printf '%s[*]%s %s\n' "$B" "$N" "$*"; }
  ok()   { printf '%s[✓]%s %s\n' "$G" "$N" "$*"; }
  warn() { printf '%s[!]%s %s\n' "$Y" "$N" "$*" >&2; }
  die()  { printf '%s[✗]%s %s\n' "$R" "$N" "$*" >&2; exit 1; }
fi
hsize() { LC_ALL=C numfmt --to=iec-i --suffix=o --format=%.1f "$1" 2>/dev/null || echo "$1 o"; }

usage() {
  cat <<EOF
${W}LinXfus $VERSION${N} — clés USB bootables Windows / macOS / Linux
Interface graphique : linxfus-gui (menu Applications → LinXfus)

${W}Usage${N}
  sudo $PROG                                   mode interactif
  sudo $PROG -i IMAGE -d /dev/sdX [options]    mode direct
  $PROG -l                                     liste les clés USB

${W}Général${N}
  -i, --image FICHIER     ISO / IMG / DMG (.xz .gz .zst .bz2 acceptés)
  -d, --device DISQUE     clé cible, disque entier (/dev/sdX)
  -t, --type TYPE         auto | windows | mac | linux     (défaut : auto)
  -L, --label NOM         nom du volume (Windows / OpenCore)
      --sha256 HASH       vérifie l'image avant écriture
  -V, --verify            relit la clé après écriture (images brutes)
  -y, --yes               pas de confirmation (dangereux)
  -f, --force             autorise un disque non amovible ou monté ailleurs
  -l, --list              liste les clés USB détectées (avec -f : tous les disques hors système)
      --deps              installe les dépendances (dnf / apt / pacman)
  -h, --help | -v, --version

${W}Windows${N}  (FAT32, install.wim > 4 Go découpé automatiquement)
  -s, --scheme mbr|gpt    mbr = BIOS + UEFI (défaut) · gpt = UEFI seul
      --no-bios           ne pas installer le chargeur BIOS (GRUB)
      --win11-bypass      saute les contrôles TPM / Secure Boot / RAM

${W}macOS${N}
      --mac-recovery VER  recovery officielle Apple : elcapitan sierra highsierra
                          mojave catalina bigsur monterey ventura sonoma sequoia tahoe
      --mac-mode MODE     raw = image disque, Mac Intel (défaut)
                          opencore = FAT32 + com.apple.recovery.boot (Hackintosh)
      --efi DOSSIER       dossier EFI OpenCore à copier (mode opencore)

${W}Exemples${N}
  sudo $PROG -i Win11.iso -d /dev/sdb --win11-bypass
  sudo $PROG -i Fedora-Workstation-Live.iso -d /dev/sdb -V
  sudo $PROG --mac-recovery sonoma -d /dev/sdb
EOF
}

# ─────────────────────────────── options ───────────────────────────────
IMAGE='' DEVICE='' TYPE=auto SCHEME=mbr LABEL='' SHA='' VERIFY=0 YES=0 FORCE=0
NO_BIOS=0 WIN11_BYPASS=0 MAC_RECOVERY='' MAC_MODE=raw EFI_DIR='' ACTION=write
ARGS=("$@")
arg() { [[ $# -ge 2 && -n $2 ]] || die "$1 attend une valeur."; }
while (($#)); do
  case $1 in
    -i|--image)     arg "$@"; IMAGE=$2; shift ;;
    -d|--device)    arg "$@"; DEVICE=$2; shift ;;
    -t|--type)      arg "$@"; TYPE=$2; shift ;;
    -s|--scheme)    arg "$@"; SCHEME=$2; shift ;;
    -L|--label)     arg "$@"; LABEL=$2; shift ;;
    --sha256)       arg "$@"; SHA=${2,,}; shift ;;
    --mac-recovery) arg "$@"; MAC_RECOVERY=${2,,}; shift ;;
    --mac-mode)     arg "$@"; MAC_MODE=$2; shift ;;
    --efi)          arg "$@"; EFI_DIR=$2; shift ;;
    -V|--verify)    VERIFY=1 ;;
    -y|--yes)       YES=1 ;;
    -f|--force)     FORCE=1 ;;
    --no-bios)      NO_BIOS=1 ;;
    --win11-bypass) WIN11_BYPASS=1 ;;
    -l|--list)      ACTION=list ;;
    --deps)         ACTION=deps ;;
    --gui)          YES=1 ;;
    -h|--help)      usage; exit 0 ;;
    -v|--version)   echo "$PROG $VERSION"; exit 0 ;;
    *)              die "Option inconnue : $1 (voir --help)" ;;
  esac
  shift
done
[[ $TYPE =~ ^(auto|windows|mac|linux)$ ]] || die "--type : auto | windows | mac | linux"
[[ $SCHEME =~ ^(mbr|gpt)$ ]]              || die "--scheme : mbr | gpt"
[[ $MAC_MODE =~ ^(raw|opencore)$ ]]       || die "--mac-mode : raw | opencore"
[[ -z $SHA || $SHA =~ ^[0-9a-f]{64}$ ]]   || die "--sha256 : 64 caractères hexadécimaux attendus."
[[ -n $MAC_RECOVERY ]] && TYPE=mac

# ─────────────────────────────── disques ───────────────────────────────
need() {
  local c miss=()
  for c; do command -v "$c" >/dev/null || miss+=("$c"); done
  ((${#miss[@]} == 0)) || die "Manquant : ${miss[*]} → sudo $PROG --deps"
}
sysblk()    { echo "/sys/class/block/${1##*/}"; }
dev_size()  { local f; f=$(sysblk "$1")/size; [[ -r $f ]] && echo $(($(<"$f") * 512)) || echo 0; }
dev_model() {
  local s m='' f; s=$(sysblk "$1")/device
  for f in "$s/vendor" "$s/model" "$s/name"; do [[ -r $f ]] && m+=" $(<"$f")"; done
  read -r m <<<"$m" || true
  echo "${m:-inconnu}"
}
dev_id()    { local s; s=$(sysblk "$1"); echo "$(<"$s/dev")|$(dev_size "$1")|$(dev_model "$1")"; }
part1()     { if [[ $1 =~ [0-9]$ ]]; then echo "${1}p1"; else echo "${1}1"; fi; }
is_removable() {
  local s; s=$(sysblk "$1")
  [[ $(readlink -f "$s") == */usb* || ${1##*/} == mmcblk* ]] && return 0
  [[ -r $s/removable && $(<"$s/removable") == 1 ]]
}

# Disques qui portent le système (/, /boot, /home, swap… y compris via LVM/LUKS) : jamais touchés.
system_disks() {
  local mp src
  {
    for mp in / /boot /boot/efi /efi /home /usr /var; do
      src=$(findmnt -nvo SOURCE "$mp" 2>/dev/null) || continue
      [[ $src == /dev/* ]] && echo "$src"
    done
    swapon --noheadings --show=NAME 2>/dev/null || true
  } | while read -r src; do
    lsblk -rnspo NAME,TYPE "$src" 2>/dev/null | awk '$2=="disk"{print $1}' || true
  done | sort -u
}

usb_disks() {  # clés amovibles ; avec --force, tous les disques sauf celui du système
  local d sys; sys=$(system_disks)
  for d in /sys/block/sd* /sys/block/mmcblk[0-9]* /sys/block/nvme* /sys/block/vd*; do
    d=/dev/${d##*/}
    [[ $d == *boot* || $d == *rpmb* ]] && continue
    is_removable "$d" || ((FORCE)) || continue
    grep -qx -- "$d" <<<"$sys" && continue
    (($(dev_size "$d") > 0)) && echo "$d"
  done
  return 0
}

list_disks() {
  local d n=0
  ((GUI)) || printf '%s%-14s %10s  %s%s\n' "$W" DISQUE TAILLE MODÈLE "$N"
  while read -r d; do
    [[ -n $d ]] || continue
    if ((GUI)); then printf '%s|%s|%s\n' "$d" "$(dev_size "$d")" "$(dev_model "$d")"; n=1; continue; fi
    printf '%-14s %10s  %s\n' "$d" "$(hsize "$(dev_size "$d")")" "$(dev_model "$d")"; n=1
  done < <(usb_disks)
  ((GUI)) && return 0
  ((n)) || warn "Aucune clé USB détectée."
}

# Partitions de la clé montées ailleurs que dans les dossiers d'automontage = suspect.
foreign_mounts() { lsblk -lnpo MOUNTPOINT "$DEVICE" 2>/dev/null | grep -vE '^$|^/(run/)?media/|^/mnt(/|$)' || true; }

install_deps() {
  if command -v dnf >/dev/null; then
    dnf install -y parted dosfstools rsync wimlib-utils grub2-tools grub2-pc-modules dmg2img python3 curl xz zstd bzip2
  elif command -v apt-get >/dev/null; then
    apt-get update && apt-get install -y parted dosfstools rsync wimtools grub-pc-bin grub2-common dmg2img python3 curl xz-utils zstd bzip2
  elif command -v pacman >/dev/null; then
    pacman -S --needed --noconfirm parted dosfstools rsync wimlib grub python curl xz zstd bzip2
    warn "dmg2img est dans l'AUR (yay -S dmg2img), utile seulement pour macOS en mode raw."
  else
    die "Gestionnaire de paquets non géré. À installer : parted dosfstools rsync wimlib grub(i386-pc) dmg2img python3 curl"
  fi
  ok "Dépendances installées."
}

# ─────────────────────────────── nettoyage ───────────────────────────────
WORK='' ISO_MNT='' USB_MNT='' WATCH=''
cleanup() {
  trap - ERR; set +e
  local m busy=0
  [[ -n $WATCH ]] && kill "$WATCH" 2>/dev/null
  for m in "$USB_MNT" "$ISO_MNT"; do
    [[ -n $m ]] && mountpoint -q "$m" && { umount "$m" 2>/dev/null || umount -l "$m" 2>/dev/null || busy=1; }
  done
  [[ -n $WORK && -d $WORK ]] || return 0
  if ((busy)); then warn "Point de montage occupé, $WORK conservé."; else rm -rf --one-file-system -- "$WORK"; fi
}
trap cleanup EXIT
trap 'echo; die "Interrompu."' INT TERM
# shellcheck disable=SC2154
trap 'rc=$?; ((BASH_SUBSHELL)) || die "Échec (code $rc) ligne $LINENO : $BASH_COMMAND"' ERR

# ─────────────────────────────── image ───────────────────────────────
mount_iso() {
  [[ -n $ISO_MNT ]] && mountpoint -q "$ISO_MNT" && return 0
  ISO_MNT=$WORK/iso; mkdir -p "$ISO_MNT"
  mount -o loop,ro,nosuid,nodev,noexec -- "$IMAGE" "$ISO_MNT" 2>/dev/null
}
iso_find() { find "$ISO_MNT" -maxdepth 3 -ipath "$ISO_MNT/$1" -print -quit 2>/dev/null; }

detect_type() {  # pas de sous-shell : le montage de l'ISO doit rester visible
  case ${IMAGE,,} in
    *.dmg) TYPE=mac; return ;;
    *.xz|*.gz|*.zst|*.bz2|*.img|*.raw|*.bin) TYPE=linux; return ;;
  esac
  TYPE=linux
  mount_iso || { warn "ISO non montable : écriture brute (dd)."; return 0; }
  if [[ -n $(iso_find sources/boot.wim)$(iso_find sources/install.wim)$(iso_find sources/install.esd) ]]; then
    TYPE=windows
  elif [[ $(blkid -o value -s TYPE -- "$IMAGE" 2>/dev/null) == hfs* ]]; then
    TYPE=mac
  fi
}

is_hybrid() { [[ $(od -An -tx1 -j510 -N2 -- "$1" | tr -d ' \n') == 55aa ]]; }
is_compressed() { case ${1,,} in *.xz|*.gz|*.zst|*.bz2) return 0 ;; *) return 1 ;; esac; }
raw_size() {  # taille réelle de l'image (vide si inconnue : gzip/bzip2)
  case ${1,,} in
    *.xz)  xz --robot -l -- "$1" 2>/dev/null | awk '$1=="totals"{print $5}' || true ;;
    *.zst) zstd -lv -- "$1" 2>/dev/null | sed -n 's/.*Decompressed Size:.*(\([0-9]*\) B).*/\1/p' | head -1 || true ;;
    *.gz|*.bz2) ;;
    *)     stat -Lc %s -- "$1" ;;
  esac
}
decompress() {  # décompresseurs parallèles quand ils sont là
  case ${1,,} in
    *.xz)  need xz; xz -T0 -dc -- "$1" ;;
    *.zst) need zstd; zstd -dcq -- "$1" ;;
    *.gz)  if command -v pigz >/dev/null; then pigz -dc -- "$1"; else need gzip; gzip -dc -- "$1"; fi ;;
    *.bz2) if command -v lbzip2 >/dev/null; then lbzip2 -dc -- "$1"; else need bzip2; bzip2 -dc -- "$1"; fi ;;
  esac
}

# ─────────────────────────────── clé ───────────────────────────────
prepare_device() {  # dernière vérification puis démontage, juste avant d'écrire
  [[ $(dev_id "$DEVICE") == "$DEV_ID" ]] || die "$DEVICE a changé depuis la confirmation (clé débranchée ?). Annulé."
  local p
  for p in $(lsblk -lnpo NAME "$DEVICE" | tac); do
    umount -- "$p" 2>/dev/null || true
    swapoff -- "$p" 2>/dev/null || true
  done
  grep -qE "^${DEVICE}(p?[0-9]+)? " /proc/mounts && die "$DEVICE est encore monté. Ferme ce qui l'utilise et relance."
  wipefs -aq -- "$DEVICE"
}

wait_part() {
  local i
  partprobe -- "$DEVICE" 2>/dev/null || true
  for i in {1..20}; do
    [[ -b $1 ]] && return 0
    ((i == 4)) && { partx -u -- "$DEVICE" 2>/dev/null || true; }
    sleep 0.5
  done
  die "La partition $1 n'apparaît pas."
}

fat_label() {  # majuscules, 11 caractères max, caractères sûrs
  local l; l=$(printf '%s' "$1" | tr '[:lower:]' '[:upper:]' | tr -cd 'A-Z0-9_-' | cut -c1-11)
  echo "${l:-$2}"
}

make_fat32() {  # $1 = mbr|gpt, $2 = label
  local p
  info "Partitionnement ($1) + FAT32 « $2 »…"
  if [[ $1 == gpt ]]; then parted -s -- "$DEVICE" mklabel gpt mkpart "$2" fat32 4MiB 100% set 1 msftdata on
  else parted -s -- "$DEVICE" mklabel msdos mkpart primary fat32 4MiB 100% set 1 boot on set 1 lba on; fi
  p=$(part1 "$DEVICE"); wait_part "$p"
  wipefs -aq -- "$p" 2>/dev/null || true
  mkfs.vfat -F 32 -n "$2" -- "$p" >/dev/null
  USB_MNT=$WORK/usb; mkdir -p "$USB_MNT"
  mount -t vfat -o nosuid,nodev,noexec,utf8,quiet -- "$p" "$USB_MNT"
}

# Copies sans métadonnées (FAT32 ne gère ni droits ni propriétaires).
copy_file() { if command -v rsync >/dev/null; then rsync --info=progress2 -- "$1" "$2"; else cat -- "$1" >"$2"; fi; }
copy_tree() {  # $1 = source, $2 = destination, puis exclusions rsync
  local s=$1 d=$2 f; shift 2
  mkdir -p "$d"
  if command -v rsync >/dev/null; then
    rsync -r --no-inc-recursive --info=progress2 "$@" -- "$s/" "$d/"; return
  fi
  (cd "$s" && find . -mindepth 1 -type d -print0) | while IFS= read -r -d '' f; do mkdir -p "$d/$f"; done
  (cd "$s" && find . -type f -print0) | while IFS= read -r -d '' f; do
    (($(stat -c %s "$s/$f") > FAT32_MAX)) && continue   # gros WIM/ESD : découpés à part
    cat -- "$s/$f" >"$d/$f"
  done
}

finish() {
  if [[ -n $USB_MNT ]] && mountpoint -q "$USB_MNT"; then
    info "Écriture des données sur la clé…"
    local pid left; sync -f "$USB_MNT" & pid=$!
    while kill -0 "$pid" 2>/dev/null; do   # progression réelle : données encore en cache
      left=$(awk '/^(Dirty|Writeback):/{s+=$2} END{print s*1024}' /proc/meminfo)
      if ((GUI)); then echo "@F $left"
      elif [[ -t 1 ]]; then printf '\r%s[*]%s Écriture sur la clé… %s restants   ' "$B" "$N" "$(hsize "$left")"; fi
      sleep 1
    done
    wait "$pid"; [[ -t 1 ]] && printf '\r\e[K'
    umount -- "$USB_MNT"
  fi
  blockdev --flushbufs "$DEVICE" 2>/dev/null || true
  ok "Clé prête : $DEVICE — tu peux la retirer."
}

# ─────────────────────────────── écriture brute ───────────────────────────────
write_raw() {
  local img=$1 size
  size=$(raw_size "$img")
  [[ -z $size ]] || ((size <= $(dev_size "$DEVICE"))) || die "Image ($(hsize "$size")) plus grande que la clé ($(hsize "$(dev_size "$DEVICE")"))."
  prepare_device
  info "Écriture de ${img##*/} sur $DEVICE…"
  [[ -n $size ]] && ((GUI)) && echo "@T $size"
  if ! is_compressed "$img"; then dd if="$img" of="$DEVICE" bs=4M oflag=direct conv=fsync status=progress
  else decompress "$img" | dd of="$DEVICE" bs=4M iflag=fullblock oflag=direct conv=fsync status=progress; fi
  if ((VERIFY)); then
    info "Vérification (relecture de la clé)…"
    blockdev --flushbufs "$DEVICE"
    if ! is_compressed "$img"; then cmp -n "$size" -- "$img" "$DEVICE"
    else size=${size:-$(decompress "$img" | wc -c)}; cmp -n "$size" -- <(decompress "$img") "$DEVICE"; fi \
      && ok "Vérification OK." || die "Vérification ÉCHOUÉE : clé défectueuse ou écriture incomplète."
  fi
  finish
}

write_linux() {
  if [[ ${IMAGE,,} == *.iso ]] && ! is_hybrid "$IMAGE"; then
    warn "Cette ISO n'est pas « isohybride » : écrite telle quelle, elle risque de ne pas démarrer."
    ((YES)) || { read -rp "Continuer quand même ? [o/N] " a; [[ ${a,,} == o* ]] || exit 1; }
  fi
  write_raw "$IMAGE"
}

# ─────────────────────────────── Windows ───────────────────────────────
write_unattend() {
  local a k i
  [[ -e $USB_MNT/autounattend.xml ]] && warn "L'ISO contenait déjà un autounattend.xml : il est remplacé."
  {
    echo '<?xml version="1.0" encoding="utf-8"?>'
    echo '<unattend xmlns="urn:schemas-microsoft-com:unattend" xmlns:wcm="http://schemas.microsoft.com/WMIConfig/2002/State">'
    echo '  <settings pass="windowsPE">'
    for a in amd64 arm64; do
      echo "    <component name=\"Microsoft-Windows-Setup\" processorArchitecture=\"$a\" publicKeyToken=\"31bf3856ad364e35\" language=\"neutral\" versionScope=\"nonSxS\">"
      echo '      <RunSynchronous>'
      i=1
      for k in BypassTPMCheck BypassSecureBootCheck BypassRAMCheck; do
        echo "        <RunSynchronousCommand wcm:action=\"add\"><Order>$i</Order><Path>reg add HKLM\\SYSTEM\\Setup\\LabConfig /v $k /t REG_DWORD /d 1 /f</Path></RunSynchronousCommand>"
        i=$((i + 1))
      done
      echo '      </RunSynchronous>'
      echo '    </component>'
    done
    echo '  </settings>'
    echo '</unattend>'
  } >"$USB_MNT/autounattend.xml"
  ok "autounattend.xml ajouté (contournement TPM / Secure Boot / RAM)."
}

install_bios_loader() {
  local gi d='' x cfg out
  gi=$(command -v grub-install || command -v grub2-install || true)
  for x in /usr/lib/grub/i386-pc /usr/lib/grub2/i386-pc; do [[ -e $x/ntldr.mod ]] && { d=$x; break; }; done
  [[ -n $gi && -n $d ]] || { warn "GRUB i386-pc absent → pas de démarrage BIOS (UEFI OK). sudo $PROG --deps"; return 0; }
  [[ -n $(iso_find bootmgr) ]] || { warn "bootmgr absent de l'ISO → pas de démarrage BIOS (UEFI OK)."; return 0; }
  info "Chargeur BIOS (GRUB → bootmgr)…"
  if ! out=$("$gi" --target=i386-pc --directory="$d" --boot-directory="$USB_MNT" --force -- "$DEVICE" 2>&1); then
    warn "grub-install a échoué (${out##*$'\n'}) → pas de démarrage BIOS (UEFI OK)."; return 0
  fi
  cfg=$USB_MNT/grub; [[ -d $USB_MNT/grub2 ]] && cfg=$USB_MNT/grub2
  printf '%s\n' '# LinXfus : démarrage BIOS de Windows' 'ntldr /bootmgr' 'boot' >"$cfg/grub.cfg"
  ok "Démarrage BIOS (Legacy/CSM) installé."
}

write_windows() {
  need parted mkfs.vfat
  mount_iso || die "Impossible de monter l'ISO $IMAGE"
  local wim esd total f src dst big=()
  wim=$(iso_find sources/install.wim); esd=$(iso_find sources/install.esd)
  [[ -n $wim$esd$(iso_find sources/boot.wim) ]] || die "Ce n'est pas une ISO d'installation Windows."
  total=$(du -sb -- "$ISO_MNT" | cut -f1)
  ((total + 67108864 < $(dev_size "$DEVICE"))) || die "Clé trop petite : il faut au moins $(hsize $((total + 67108864)))."
  for f in "$wim" "$esd"; do
    if [[ -n $f ]] && (($(stat -c %s -- "$f") > FAT32_MAX)); then big+=("$f"); fi
  done
  ((${#big[@]})) && need wimlib-imagex
  [[ -z $(find "$ISO_MNT" -type f -size +"$FAT32_MAX"c ! -iname install.wim ! -iname install.esd -print -quit) ]] \
    || die "L'ISO contient un autre fichier > 4 Go, impossible sur FAT32."

  prepare_device
  make_fat32 "$SCHEME" "$(fat_label "${LABEL:-$(blkid -o value -s LABEL -- "$IMAGE" 2>/dev/null || true)}" WINUSB)"
  info "Copie des fichiers Windows ($(hsize "$total"))…"
  copy_tree "$ISO_MNT" "$USB_MNT" "${big[@]/#"$ISO_MNT"/--exclude=}"

  for f in "${big[@]}"; do
    src=$f dst=$USB_MNT${f#"$ISO_MNT"}; dst=${dst%.*}.swm
    if [[ ${f,,} == *.esd ]]; then  # un ESD (compression solide) ne se découpe pas : conversion en WIM
      info "install.esd > 4 Go → conversion en WIM…"
      src=$WORK/install.wim; wimlib-imagex export "$f" all "$src" --compress=LZX
    fi
    info "${f##*/} > 4 Go → découpage en morceaux de $SWM_MB Mo…"
    wimlib-imagex split "$src" "$dst" "$SWM_MB"
  done

  ((WIN11_BYPASS)) && write_unattend
  [[ $SCHEME == mbr ]] && ((!NO_BIOS)) && install_bios_loader
  finish
  [[ $SCHEME == gpt ]] && info "Schéma GPT : démarre la clé en mode UEFI."
  return 0
}

# ─────────────────────────────── macOS ───────────────────────────────
readonly MAC_VERSIONS=(elcapitan sierra highsierra mojave catalina bigsur monterey ventura sonoma sequoia tahoe)
mac_board() {  # identifiants publiés par OpenCorePkg (Utilities/macrecovery/recovery_urls.txt)
  case $1 in
    elcapitan|10.11)  echo Mac-FFE5EF870D7BA81A 00000000000GQRX00 default ;;
    sierra|10.12)     echo Mac-77F17D7DA9285301 00000000000J0DX00 default ;;
    highsierra|10.13) echo Mac-7BA5B2D9E42DDD94 00000000000J80300 default ;;
    mojave|10.14)     echo Mac-7BA5B2DFE22DDD8C 00000000000KXPG00 default ;;
    catalina|10.15)   echo Mac-00BE6ED71E35EB86 00000000000000000 default ;;
    bigsur|11)        echo Mac-2BD1B31983FE1663 00000000000000000 default ;;
    monterey|12)      echo Mac-E43C1C25D4880AD6 00000000000000000 default ;;
    ventura|13)       echo Mac-B4831CEBD52A0C4C 00000000000000000 default ;;
    sonoma|14)        echo Mac-827FAC58A8FDFA22 00000000000000000 default ;;
    sequoia|15)       echo Mac-7BA5B2D9E42DDD94 00000000000000000 default ;;
    tahoe|26)         echo Mac-CFF7D910A743CAAF 00000000000000000 latest ;;
    *) return 1 ;;
  esac
}

MAC_DMG=''
download_mac_recovery() {  # renseigne MAC_DMG — image vérifiée contre la chunklist signée par Apple
  need python3 curl sha256sum
  local bid mlb os dir out py cnk
  read -r bid mlb os < <(mac_board "$1") || die "Version macOS inconnue : $1 (${MAC_VERSIONS[*]})"
  dir=$CACHE/macos-$1 out=$CACHE/macos-$1/com.apple.recovery.boot py=$CACHE/macrecovery-1.0.8.py
  mkdir -p "$dir"
  if ! sha256sum -c --status <<<"$OC_SHA  $py" 2>/dev/null; then
    info "Téléchargement de macrecovery (OpenCorePkg 1.0.8)…"
    curl -fsSL --proto '=https' --tlsv1.2 -o "$py.part" -- "$OC_URL" || die "Téléchargement de macrecovery impossible."
    sha256sum -c --status <<<"$OC_SHA  $py.part" || { rm -f -- "$py.part"; die "Empreinte de macrecovery invalide : refusé."; }
    mv -f -- "$py.part" "$py"
  fi
  MAC_DMG=$(find "$out" -maxdepth 1 -iname '*.dmg' -print -quit 2>/dev/null || true)
  if [[ -n $MAC_DMG ]]; then
    cnk=${MAC_DMG%.*}.chunklist
    info "Recovery $1 en cache, vérification…"
    if python3 -I -c 'import importlib.util as u,sys;s=u.spec_from_file_location("m",sys.argv[1]);m=u.module_from_spec(s);s.loader.exec_module(m);m.verify_image(sys.argv[2],sys.argv[3])' \
         "$py" "$MAC_DMG" "$cnk" >/dev/null 2>&1; then
      ok "Cache valide : $out"; return 0
    fi
    warn "Cache corrompu : nouveau téléchargement."; rm -rf -- "$out"
  fi
  info "Téléchargement de la recovery macOS $1 depuis les serveurs Apple…"
  python3 -I "$py" -b "$bid" -m "$mlb" -os "$os" -o "$out" download || { rm -rf -- "$out"; die "Échec du téléchargement."; }
  MAC_DMG=$(find "$out" -maxdepth 1 -iname '*.dmg' -print -quit)
  [[ -n $MAC_DMG ]] || die "Aucun .dmg récupéré."
  ok "Recovery téléchargée et vérifiée : $MAC_DMG"
}

write_mac() {
  local img=$IMAGE cnk
  if [[ -n $MAC_RECOVERY ]]; then download_mac_recovery "$MAC_RECOVERY"; img=$MAC_DMG; fi
  [[ -f $img ]] || die "Image introuvable : $img"

  if [[ $MAC_MODE == opencore ]]; then
    need parted mkfs.vfat
    [[ ${img,,} == *.dmg ]] || die "Le mode opencore attend un BaseSystem.dmg / RecoveryImage.dmg."
    cnk=${img%.*}.chunklist
    prepare_device
    make_fat32 gpt "$(fat_label "$LABEL" MACRECOVERY)"
    info "Copie de la recovery dans com.apple.recovery.boot…"
    mkdir -p "$USB_MNT/com.apple.recovery.boot"
    copy_file "$img" "$USB_MNT/com.apple.recovery.boot/${img##*/}"
    if [[ -f $cnk ]]; then copy_file "$cnk" "$USB_MNT/com.apple.recovery.boot/${cnk##*/}"
    else warn "Pas de .chunklist à côté du .dmg (OpenCore peut le réclamer)."; fi
    if [[ -n $EFI_DIR ]]; then
      info "Copie du dossier EFI OpenCore…"; copy_tree "$EFI_DIR" "$USB_MNT/EFI"
    else
      warn "Pas de --efi : ajoute ton dossier EFI OpenCore à la racine de la clé avant de démarrer."
    fi
    finish; return 0
  fi

  if [[ ${img,,} == *.dmg ]]; then
    need dmg2img
    info "Contrôle du DMG (avant d'effacer la clé)…"
    dmg2img -s -i "$img" -o /dev/null >/dev/null 2>&1 \
      || die "dmg2img ne sait pas décompresser ce DMG (LZFSE, Big Sur et +). Utilise : --mac-mode opencore"
    prepare_device
    info "Conversion DMG → image disque, écriture directe sur $DEVICE…"
    dmg2img -i "$img" -o "$DEVICE"
    sync
    finish
  else
    write_raw "$img"
  fi
  info "Sur le Mac (Intel) : maintiens ⌥ Option au démarrage et choisis la clé."
}

# ─────────────────────────────── interactif ───────────────────────────────
interactive() {
  local a i disks=()
  echo "${W}═══ LinXfus $VERSION — clé USB bootable ═══${N}"
  if [[ -z $IMAGE && -z $MAC_RECOVERY ]]; then
    echo "Image (ISO/IMG/DMG, Tab pour compléter) ou « mac » pour télécharger une recovery macOS :"
    read -erp "> " a
    a=${a%"${a##*[![:space:]]}"}; a=${a#\"}; a=${a%\"}; a=${a#\'}; a=${a%\'}; a=${a/#\~/$HOME}
    if [[ ${a,,} == mac ]]; then
      echo "Version macOS :"
      select a in "${MAC_VERSIONS[@]}"; do [[ -n $a ]] && break; done
      MAC_RECOVERY=$a TYPE=mac
      read -rp "Cible : 1) Mac Intel  2) Hackintosh/OpenCore [1] " a
      if [[ $a == 2 ]]; then
        MAC_MODE=opencore
        read -erp "Dossier EFI OpenCore (vide = plus tard) : " a; [[ -n $a ]] && EFI_DIR=${a/#\~/$HOME}
      fi
    else
      IMAGE=$a
    fi
  fi
  if [[ -z $DEVICE ]]; then
    mapfile -t disks < <(usb_disks)
    ((${#disks[@]})) || die "Aucune clé USB détectée. Branche-la et relance."
    echo "Clés détectées :"
    for i in "${!disks[@]}"; do
      printf '  %d) %-12s %10s  %s\n' $((i + 1)) "${disks[i]}" "$(hsize "$(dev_size "${disks[i]}")")" "$(dev_model "${disks[i]}")"
    done
    read -rp "Choix [1] : " a; a=${a:-1}
    [[ $a =~ ^[0-9]+$ ]] && ((a >= 1 && a <= ${#disks[@]})) || die "Choix invalide."
    DEVICE=${disks[a - 1]}
  fi
  INTERACTIVE=1
}

# ─────────────────────────────── principal ───────────────────────────────
[[ $ACTION == list ]] && { list_disks; exit 0; }
if ((EUID != 0)); then
  command -v sudo >/dev/null || die "À lancer en root."
  exec sudo -- "$BASH" "$(readlink -f -- "$0")" "${ARGS[@]}"
fi
[[ $ACTION == deps ]] && { install_deps; exit 0; }

need lsblk blockdev wipefs dd findmnt mount umount mountpoint numfmt blkid
WORK=$(mktemp -d /var/tmp/linxfus.XXXXXX)
if ((GUI)); then  # l'interface ferme stdin pour annuler : on arrête tout le groupe (dd, rsync…)
  exec {IN}<&0
  { while read -r _; do :; done; kill -TERM 0; } <&"$IN" &
  WATCH=$!
fi
INTERACTIVE=0
if [[ (-z $IMAGE && -z $MAC_RECOVERY) || -z $DEVICE ]]; then
  [[ -t 0 ]] || die "Image (-i) et clé (-d) requises hors terminal. Voir --help."
  interactive
fi

if [[ -n $MAC_RECOVERY ]]; then
  mac_board "$MAC_RECOVERY" >/dev/null || die "Version macOS inconnue : $MAC_RECOVERY (${MAC_VERSIONS[*]})"
else
  [[ -f $IMAGE ]] || die "Image introuvable : $IMAGE"
  IMAGE=$(readlink -f -- "$IMAGE")
  if [[ -n $SHA ]]; then
    info "Calcul du SHA-256…"
    [[ $(sha256sum -- "$IMAGE" | cut -d' ' -f1) == "$SHA" ]] || die "SHA-256 différent : image corrompue ou mauvaise version."
    ok "SHA-256 conforme."
  fi
  [[ $TYPE == auto ]] && detect_type
fi
if [[ -n $EFI_DIR ]]; then
  [[ -d $EFI_DIR ]] || die "Dossier EFI introuvable : $EFI_DIR"
  EFI_DIR=$(readlink -f -- "$EFI_DIR")
  [[ -d $EFI_DIR/BOOT || -d $EFI_DIR/OC ]] || warn "$EFI_DIR ne ressemble pas à un dossier EFI OpenCore (BOOT/ ou OC/ absents)."
fi

# Clé cible : toutes les vérifications avant la moindre écriture
[[ -b $DEVICE ]] || die "$DEVICE n'est pas un périphérique bloc."
DEVICE=$(readlink -f -- "$DEVICE")
case $(lsblk -dno TYPE -- "$DEVICE") in
  disk) ;;
  loop) ((FORCE)) || die "$DEVICE est un loop device (--force pour l'utiliser)." ;;
  *)    die "Donne le disque entier (ex. /dev/sdb), pas une partition." ;;
esac
grep -qx -- "$DEVICE" <<<"$(system_disks)" && die "$DEVICE contient ton système. Refusé."
is_removable "$DEVICE" || ((FORCE)) || die "$DEVICE n'est pas une clé amovible. --force si tu es sûr."
fm=$(foreign_mounts)
[[ -z $fm ]] || ((FORCE)) || die "$DEVICE est monté sur ${fm//$'\n'/, } (pas une clé ordinaire). --force si tu es sûr."
DEV_ID=$(dev_id "$DEVICE")

if ((INTERACTIVE)) && [[ $TYPE == windows ]]; then
  read -rp "Schéma : 1) MBR, BIOS + UEFI (recommandé)  2) GPT, UEFI seul [1] " a; [[ $a == 2 ]] && SCHEME=gpt
  read -rp "Windows 11 : contourner TPM / Secure Boot / RAM ? [o/N] " a; [[ ${a,,} == o* ]] && WIN11_BYPASS=1
fi

case $TYPE in
  windows) desc="Windows — FAT32, MBR (BIOS + UEFI)"; [[ $SCHEME == gpt ]] && desc="Windows — FAT32, GPT (UEFI)"
           ((WIN11_BYPASS)) && desc+=", bypass Win11" ;;
  mac)     desc="macOS — image disque (Mac Intel)"; [[ $MAC_MODE == opencore ]] && desc="macOS — OpenCore (com.apple.recovery.boot)" ;;
  linux)   desc="Linux / image brute — écriture dd" ;;
esac
echo
echo "${W}Récapitulatif${N}"
if [[ -n $MAC_RECOVERY ]]; then echo "  Image : recovery macOS « $MAC_RECOVERY » (serveurs Apple)"
else echo "  Image : ${IMAGE##*/} ($(hsize "$(stat -c %s -- "$IMAGE")"))"; fi
echo "  Mode  : $desc"
echo "  Clé   : $DEVICE — $(dev_model "$DEVICE") — $(hsize "$(dev_size "$DEVICE")")"
echo "  ${R}${W}⚠ TOUT le contenu de $DEVICE va être effacé.${N}"
if ((!YES)); then
  [[ -t 0 ]] || die "Pas de terminal pour confirmer : ajoute --yes."
  read -rp "Tape OUI pour continuer : " a
  [[ $a == OUI ]] || die "Annulé."
fi

case $TYPE in
  windows) write_windows ;;
  mac)     write_mac ;;
  linux)   write_linux ;;
esac
